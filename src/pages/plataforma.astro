---
const apiUrl = import.meta.env.PUBLIC_SAAS_API_URL ?? "http://localhost:4100";
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="Administración de la plataforma Criptón." />
    <title>Plataforma | Criptón</title>
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="/"><span aria-hidden="true">C</span><strong>Criptón</strong></a>
      <div class="operator" id="operator" hidden>
        <span data-field="operator-name"></span>
        <button class="quiet-button" data-action="logout" type="button">Cerrar sesión</button>
      </div>
    </header>

    <main id="platform" data-api-url={apiUrl}>
      <section class="access" data-view="access">
        <div class="access-heading">
          <p class="eyebrow">Operación interna</p>
          <h1>Administración</h1>
          <p>Primera vez: configura MFA. Después ingresa con el código de tu autenticador.</p>
        </div>

        <div class="access-tool">
          <div class="segments" role="tablist" aria-label="Modo de acceso">
            <button class="segment" type="button" role="tab" aria-selected="false" data-mode="enroll">Configurar MFA</button>
            <button class="segment active" type="button" role="tab" aria-selected="true" data-mode="login">Ingresar</button>
          </div>

          <form id="login-form" class="auth-form">
            <label>Correo<input name="email" type="email" autocomplete="username" required /></label>
            <label>Contraseña<input name="password" type="password" autocomplete="current-password" maxlength="72" required /></label>
            <label>Código de 6 dígitos<input name="code" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" placeholder="000000" aria-describedby="login-code-help" required /></label>
            <small id="login-code-help">Usa el código que muestra tu app de autenticación.</small>
            <button class="primary-button" type="submit">Ingresar</button>
          </form>

          <form id="enroll-form" class="auth-form" hidden>
            <label>Correo<input name="email" type="email" autocomplete="username" required /></label>
            <label>Contraseña<input name="password" type="password" autocomplete="current-password" maxlength="72" required /></label>
            <button class="primary-button" type="submit">Generar factor</button>
          </form>

          <form id="verify-form" class="auth-form" hidden>
            <div class="secret-block">
              <span>Clave para agregar en tu autenticador</span>
              <code data-field="mfa-secret"></code>
              <button class="quiet-button" data-action="copy-secret" type="button">Copiar clave</button>
            </div>
            <label>Código de 6 dígitos<input name="code" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" placeholder="000000" aria-describedby="verify-code-help" required /></label>
            <small id="verify-code-help">Después de registrar la clave en tu autenticador, escribe el código mostrado.</small>
            <button class="primary-button" type="submit">Activar MFA</button>
          </form>
          <p class="status" role="status" aria-live="polite"></p>
        </div>
      </section>

      <section class="workspace" data-view="workspace" hidden>
        <div class="workspace-heading">
          <div><p class="eyebrow">Plataforma</p><h1>Empresas</h1></div>
          <div class="summary"><strong data-field="visible-count">0</strong><span>en esta vista</span></div>
        </div>

        <div class="toolbar">
          <label for="status-filter">Estado</label>
          <select id="status-filter">
            <option value="">Todos</option>
            <option value="active">Activo</option>
            <option value="provisioning">Aprovisionando</option>
            <option value="restricted">Restringido</option>
            <option value="suspended">Suspendido</option>
            <option value="failed">Fallido</option>
            <option value="pending">Pendiente</option>
            <option value="offboarding">Retiro</option>
            <option value="deleted">Eliminado</option>
          </select>
          <button class="secondary-button" data-action="refresh" type="button">Actualizar</button>
          <p class="status table-status" role="status" aria-live="polite"></p>
        </div>

        <div class="table-wrap">
          <table>
            <thead><tr><th>Empresa</th><th>Estado</th><th>Plan</th><th>Periodo</th><th>Provisioning</th><th></th></tr></thead>
            <tbody id="tenant-rows"></tbody>
          </table>
          <div class="empty" id="empty-state" hidden>No hay empresas para este filtro.</div>
        </div>
        <button class="secondary-button load-more" data-action="load-more" type="button" hidden>Cargar más</button>
      </section>

      <dialog id="tenant-dialog">
        <div class="dialog-heading">
          <div><p class="eyebrow">Empresa</p><h2 data-field="detail-name"></h2><p data-field="detail-key"></p></div>
          <button class="close-button" data-action="close-detail" type="button" aria-label="Cerrar">×</button>
        </div>
        <dl class="detail-grid">
          <div><dt>Estado</dt><dd data-field="detail-status"></dd></div>
          <div><dt>Plan</dt><dd data-field="detail-plan"></dd></div>
          <div><dt>Contacto</dt><dd data-field="detail-contact"></dd></div>
          <div><dt>Correo</dt><dd data-field="detail-email"></dd></div>
          <div><dt>Periodo</dt><dd data-field="detail-period"></dd></div>
          <div><dt>Provisioning</dt><dd data-field="detail-provisioning"></dd></div>
        </dl>
        <section class="steps-section">
          <h3>Pasos de provisioning</h3>
          <ol id="provisioning-steps"></ol>
        </section>
        <form id="lifecycle-form" class="lifecycle-form" hidden>
          <div>
            <h3 data-field="lifecycle-title"></h3>
            <p data-field="lifecycle-copy"></p>
          </div>
          <label>Motivo
            <textarea name="reason" minlength="8" maxlength="500" rows="3" required></textarea>
          </label>
          <label class="confirmation">
            <input name="confirmed" type="checkbox" required />
            Confirmo que revisé la empresa y su estado de facturación.
          </label>
          <button class="primary-button" data-action="lifecycle" type="submit"></button>
        </form>
        <p class="status dialog-status" role="status" aria-live="polite"></p>
      </dialog>
    </main>

    <script>
      type TenantSummary = {
        tenantId: string; tenantKey: string; name: string; status: string;
        createdAt: string; activatedAt: string | null;
        subscription: null | { status: string; planCode: string; planName: string; currentPeriodEnd: string | null };
        provisioning: null | { jobId: string; operation: string; status: string; attemptCount: number };
      };
      type TenantDetail = TenantSummary & {
        profile: null | { contactName: string; contactEmail: string };
        provisioningSteps: Array<{ code: string; status: string; attemptCount: number }>;
      };
      type Enrollment = { factorId: string; secret: string; otpauthUrl: string };

      const root = document.querySelector<HTMLElement>("#platform")!;
      const apiUrl = root.dataset.apiUrl?.replace(/\/$/, "") ?? "";
      const accessView = root.querySelector<HTMLElement>("[data-view='access']")!;
      const workspace = root.querySelector<HTMLElement>("[data-view='workspace']")!;
      const operator = document.querySelector<HTMLElement>("#operator")!;
      const loginForm = root.querySelector<HTMLFormElement>("#login-form")!;
      const enrollForm = root.querySelector<HTMLFormElement>("#enroll-form")!;
      const verifyForm = root.querySelector<HTMLFormElement>("#verify-form")!;
      const accessStatus = root.querySelector<HTMLElement>(".access-tool>.status")!;
      const tableStatus = root.querySelector<HTMLElement>(".table-status")!;
      const rows = root.querySelector<HTMLTableSectionElement>("#tenant-rows")!;
      const emptyState = root.querySelector<HTMLElement>("#empty-state")!;
      const statusFilter = root.querySelector<HTMLSelectElement>("#status-filter")!;
      const loadMore = root.querySelector<HTMLButtonElement>("[data-action='load-more']")!;
      const dialog = root.querySelector<HTMLDialogElement>("#tenant-dialog")!;
      let token = "";
      let nextCursor: string | null = null;
      let enrollment: Enrollment | null = null;
      let enrollmentCredentials: { email: string; password: string } | null = null;
      let selectedTenant: TenantDetail | null = null;

      const field = (name: string) => root.querySelector<HTMLElement>(`[data-field='${name}']`)!;
      const messageFrom = (body: unknown, fallback: string) => typeof body === "object" && body && "error" in body
        ? (body as { error?: { message?: string } }).error?.message ?? fallback
        : fallback;
      const labels: Record<string, string> = {
        active: "Activo", provisioning: "Aprovisionando", restricted: "Restringido",
        suspended: "Suspendido", failed: "Fallido", pending: "Pendiente",
        offboarding: "Retiro", deleted: "Eliminado", completed: "Completado",
        running: "En curso", retry: "Reintento", dead_letter: "Revisión manual"
      };
      const formatDate = (value: string | null) => value
        ? new Intl.DateTimeFormat("es-CO", { dateStyle: "medium" }).format(new Date(value))
        : "Sin fecha";
      const createIdempotencyKey = () => globalThis.crypto?.randomUUID?.()
        ?? `platform-${Date.now()}-${Math.random().toString(36).slice(2)}`;
      const resetSession = () => {
        token = "";
        nextCursor = null;
        rows.replaceChildren();
        workspace.hidden = true;
        operator.hidden = true;
        selectedTenant = null;
        if (dialog.open) dialog.close();
        accessView.hidden = false;
      };
      const request = async (path: string, options: RequestInit = {}) => {
        const response = await fetch(`${apiUrl}${path}`, options);
        const body = response.status === 204 ? null : await response.json().catch(() => null);
        if (response.status === 401 && token) resetSession();
        if (!response.ok) throw body ?? new Error(`HTTP ${response.status}`);
        return body;
      };
      const credentialsFrom = (form: HTMLFormElement) => {
        const data = new FormData(form);
        return { email: String(data.get("email") ?? ""), password: String(data.get("password") ?? "") };
      };
      const setBusy = (form: HTMLFormElement, busy: boolean) => {
        form.querySelectorAll<HTMLInputElement>("input").forEach((control) => { control.readOnly = busy; });
        form.querySelectorAll<HTMLButtonElement>("button").forEach((control) => { control.disabled = busy; });
      };
      const setAccessMessage = (message: string, state = "") => {
        accessStatus.textContent = message;
        accessStatus.dataset.state = state;
      };
      const bindTotpValidation = (input: HTMLInputElement) => {
        input.addEventListener("input", () => {
          const value = input.value.trim();
          input.setCustomValidity(value && !/^\d{0,6}$/.test(value)
            ? "Ingresa los 6 dígitos de tu autenticador. La clave TOTP se registra en la app, no aquí."
            : "");
        });
      };
      root.querySelectorAll<HTMLInputElement>("input[name='code']").forEach(bindTotpValidation);

      root.querySelectorAll<HTMLButtonElement>("[data-mode]").forEach((button) => {
        button.addEventListener("click", () => {
          const enroll = button.dataset.mode === "enroll";
          root.querySelectorAll<HTMLButtonElement>("[data-mode]").forEach((candidate) => {
            const active = candidate === button;
            candidate.classList.toggle("active", active);
            candidate.setAttribute("aria-selected", String(active));
          });
          loginForm.hidden = enroll;
          enrollForm.hidden = !enroll;
          verifyForm.hidden = true;
          enrollment = null;
          enrollmentCredentials = null;
          setAccessMessage("");
        });
      });

      enrollForm.addEventListener("submit", async (event) => {
        event.preventDefault();
        setBusy(enrollForm, true);
        setAccessMessage("Generando factor…");
        try {
          enrollmentCredentials = credentialsFrom(enrollForm);
          enrollment = await request("/v1/platform/auth/mfa/enroll", {
            method: "POST", headers: { "content-type": "application/json" },
            body: JSON.stringify(enrollmentCredentials)
          }) as Enrollment;
          field("mfa-secret").textContent = enrollment.secret;
          enrollForm.hidden = true;
          verifyForm.hidden = false;
          setAccessMessage("Agrega la clave en tu app de autenticación y escribe su código de 6 dígitos.", "success");
          verifyForm.querySelector<HTMLInputElement>("input[name='code']")!.focus();
        } catch (error) {
          setAccessMessage(messageFrom(error, "No fue posible generar el factor."), "error");
        } finally {
          setBusy(enrollForm, false);
        }
      });

      verifyForm.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!enrollmentCredentials || !enrollment) return;
        setBusy(verifyForm, true);
        setAccessMessage("Verificando código…");
        try {
          const data = new FormData(verifyForm);
          await request("/v1/platform/auth/mfa/verify", {
            method: "POST", headers: { "content-type": "application/json" },
            body: JSON.stringify({ ...enrollmentCredentials, code: String(data.get("code") ?? "") })
          });
          loginForm.querySelector<HTMLInputElement>("input[name='email']")!.value = enrollmentCredentials.email;
          verifyForm.hidden = true;
          loginForm.hidden = false;
          setAccessMessage("MFA activo. Ingresa con un código nuevo.", "success");
          enrollment = null;
          enrollmentCredentials = null;
        } catch (error) {
          setAccessMessage(messageFrom(error, "No fue posible activar MFA."), "error");
        } finally {
          setBusy(verifyForm, false);
        }
      });

      root.querySelector<HTMLButtonElement>("[data-action='copy-secret']")!.addEventListener("click", async () => {
        if (!enrollment) return;
        try {
          await navigator.clipboard.writeText(enrollment.secret);
          setAccessMessage("Clave para configurar el autenticador copiada.", "success");
        } catch {
          setAccessMessage("No fue posible copiar. Selecciona la clave manualmente.", "error");
        }
      });

      loginForm.addEventListener("submit", async (event) => {
        event.preventDefault();
        setBusy(loginForm, true);
        setAccessMessage("Validando acceso…");
        try {
          const data = new FormData(loginForm);
          const login = await request("/v1/platform/auth/login", {
            method: "POST", headers: { "content-type": "application/json" },
            body: JSON.stringify({ ...credentialsFrom(loginForm), code: String(data.get("code") ?? "") })
          }) as { accessToken: string; principal: { displayName: string; roles: string[] } };
          token = login.accessToken;
          document.querySelector<HTMLElement>("[data-field='operator-name']")!.textContent = login.principal.displayName;
          accessView.hidden = true;
          workspace.hidden = false;
          operator.hidden = false;
          loginForm.reset();
          await loadTenants(false);
        } catch (error) {
          token = "";
          setAccessMessage(messageFrom(error, "No fue posible iniciar sesión."), "error");
        } finally {
          setBusy(loginForm, false);
        }
      });

      const tenantRow = (tenant: TenantSummary) => {
        const row = document.createElement("tr");
        const name = document.createElement("td");
        const strong = document.createElement("strong");
        strong.textContent = tenant.name;
        const key = document.createElement("span");
        key.textContent = tenant.tenantKey;
        name.append(strong, key);
        const state = document.createElement("td");
        const badge = document.createElement("span");
        badge.className = "badge";
        badge.dataset.state = tenant.status;
        badge.textContent = labels[tenant.status] ?? tenant.status;
        state.append(badge);
        const plan = document.createElement("td");
        plan.textContent = tenant.subscription?.planName ?? "Sin suscripción";
        const period = document.createElement("td");
        period.textContent = formatDate(tenant.subscription?.currentPeriodEnd ?? null);
        const provisioning = document.createElement("td");
        provisioning.textContent = tenant.provisioning ? (labels[tenant.provisioning.status] ?? tenant.provisioning.status) : "Sin job";
        const action = document.createElement("td");
        const button = document.createElement("button");
        button.className = "row-button";
        button.type = "button";
        button.textContent = "Ver";
        button.addEventListener("click", () => void showDetail(tenant.tenantId));
        action.append(button);
        row.append(name, state, plan, period, provisioning, action);
        return row;
      };

      const loadTenants = async (append: boolean) => {
        if (!token) return;
        tableStatus.textContent = "Consultando empresas…";
        tableStatus.dataset.state = "";
        loadMore.disabled = true;
        try {
          const query = new URLSearchParams({ limit: "25" });
          if (statusFilter.value) query.set("status", statusFilter.value);
          if (append && nextCursor) query.set("cursor", nextCursor);
          const body = await request(`/v1/platform/tenants?${query}`, {
            headers: { authorization: `Bearer ${token}` }
          }) as { tenants: TenantSummary[]; nextCursor: string | null };
          if (!append) rows.replaceChildren();
          rows.append(...body.tenants.map(tenantRow));
          nextCursor = body.nextCursor;
          loadMore.hidden = !nextCursor;
          emptyState.hidden = rows.children.length > 0;
          field("visible-count").textContent = String(rows.children.length);
          tableStatus.textContent = "";
        } catch (error) {
          tableStatus.textContent = messageFrom(error, "No fue posible consultar las empresas.");
          tableStatus.dataset.state = "error";
        } finally {
          loadMore.disabled = false;
        }
      };

      const showDetail = async (tenantId: string) => {
        dialog.showModal();
        const dialogStatus = root.querySelector<HTMLElement>(".dialog-status")!;
        const lifecycleForm = root.querySelector<HTMLFormElement>("#lifecycle-form")!;
        selectedTenant = null;
        lifecycleForm.hidden = true;
        lifecycleForm.reset();
        ["detail-name", "detail-key", "detail-status", "detail-plan", "detail-contact",
          "detail-email", "detail-period", "detail-provisioning"].forEach((name) => {
          field(name).textContent = "";
        });
        root.querySelector<HTMLOListElement>("#provisioning-steps")!.replaceChildren();
        dialogStatus.textContent = "Consultando detalle…";
        try {
          const tenant = await request(`/v1/platform/tenants/${encodeURIComponent(tenantId)}`, {
            headers: { authorization: `Bearer ${token}` }
          }) as TenantDetail;
          selectedTenant = tenant;
          field("detail-name").textContent = tenant.name;
          field("detail-key").textContent = tenant.tenantKey;
          field("detail-status").textContent = labels[tenant.status] ?? tenant.status;
          field("detail-plan").textContent = tenant.subscription?.planName ?? "Sin suscripción";
          field("detail-contact").textContent = tenant.profile?.contactName ?? "Sin contacto";
          field("detail-email").textContent = tenant.profile?.contactEmail ?? "Sin correo";
          field("detail-period").textContent = formatDate(tenant.subscription?.currentPeriodEnd ?? null);
          field("detail-provisioning").textContent = tenant.provisioning ? `${labels[tenant.provisioning.status] ?? tenant.provisioning.status} · intento ${tenant.provisioning.attemptCount}` : "Sin job";
          const steps = root.querySelector<HTMLOListElement>("#provisioning-steps")!;
          steps.replaceChildren(...tenant.provisioningSteps.map((step) => {
            const item = document.createElement("li");
            const code = document.createElement("span");
            code.textContent = step.code;
            const state = document.createElement("strong");
            state.textContent = labels[step.status] ?? step.status;
            item.append(code, state);
            return item;
          }));
          const canSuspend = tenant.status === "active" || tenant.status === "restricted";
          const canReactivate = tenant.status === "suspended";
          lifecycleForm.hidden = !canSuspend && !canReactivate;
          if (!lifecycleForm.hidden) {
            const operation = canReactivate ? "reactivate" : "suspend";
            lifecycleForm.dataset.operation = operation;
            field("lifecycle-title").textContent = canReactivate ? "Reactivar empresa" : "Suspender empresa";
            field("lifecycle-copy").textContent = canReactivate
              ? "Restablece el acceso cuando la suscripción esté vigente."
              : "Bloquea el acceso operativo sin eliminar información.";
            const action = lifecycleForm.querySelector<HTMLButtonElement>("[data-action='lifecycle']")!;
            action.textContent = canReactivate ? "Reactivar empresa" : "Suspender empresa";
            action.classList.toggle("danger-button", !canReactivate);
          }
          dialogStatus.textContent = "";
        } catch (error) {
          dialogStatus.textContent = messageFrom(error, "No fue posible consultar el detalle.");
          dialogStatus.dataset.state = "error";
        }
      };

      root.querySelector<HTMLFormElement>("#lifecycle-form")!.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!selectedTenant) return;
        const form = event.currentTarget as HTMLFormElement;
        const operation = form.dataset.operation as "suspend" | "reactivate";
        const data = new FormData(form);
        const reason = String(data.get("reason") ?? "").trim();
        const button = form.querySelector<HTMLButtonElement>("[data-action='lifecycle']")!;
        const dialogStatus = root.querySelector<HTMLElement>(".dialog-status")!;
        button.disabled = true;
        dialogStatus.dataset.state = "";
        dialogStatus.textContent = operation === "suspend" ? "Registrando suspensión…" : "Registrando reactivación…";
        try {
          const result = await request(`/v1/platform/tenants/${encodeURIComponent(selectedTenant.tenantId)}/lifecycle`, {
            method: "POST",
            headers: {
              authorization: `Bearer ${token}`,
              "content-type": "application/json",
              "idempotency-key": createIdempotencyKey()
            },
            body: JSON.stringify({ operation, reason })
          }) as { status: string; jobStatus: string };
          dialogStatus.dataset.state = "success";
          dialogStatus.textContent = `${labels[result.status] ?? result.status}. Sincronización ${labels[result.jobStatus] ?? result.jobStatus}.`;
          form.hidden = true;
          field("detail-status").textContent = labels[result.status] ?? result.status;
          nextCursor = null;
          await loadTenants(false);
        } catch (error) {
          dialogStatus.dataset.state = "error";
          dialogStatus.textContent = messageFrom(error, "No fue posible cambiar el estado de la empresa.");
        } finally {
          button.disabled = false;
        }
      });

      statusFilter.addEventListener("change", () => { nextCursor = null; void loadTenants(false); });
      root.querySelector<HTMLButtonElement>("[data-action='refresh']")!.addEventListener("click", () => { nextCursor = null; void loadTenants(false); });
      loadMore.addEventListener("click", () => void loadTenants(true));
      root.querySelector<HTMLButtonElement>("[data-action='close-detail']")!.addEventListener("click", () => dialog.close());
      operator.querySelector<HTMLButtonElement>("[data-action='logout']")!.addEventListener("click", () => {
        resetSession();
        setAccessMessage("");
        loginForm.querySelector<HTMLInputElement>("input[name='email']")!.focus();
      });
    </script>
  </body>
</html>

<style is:global>
  [hidden]{display:none!important}
  :root{--ink:#17201e;--muted:#596763;--paper:#f4f6f3;--white:#fff;--line:#d7dfda;--green:#123f38;--green-2:#1c5d51;--coral:#a9472d;--gold:#d4a647;font-family:Inter,"Aptos","Segoe UI",Arial,sans-serif;color:var(--ink);background:var(--paper)}
  *{box-sizing:border-box}body{margin:0;min-width:320px;line-height:1.45}.topbar{display:flex;min-height:64px;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);padding:0 clamp(18px,4vw,56px);background:var(--white)}
  .brand{display:flex;align-items:center;gap:10px;color:var(--ink);text-decoration:none}.brand span{display:grid;width:34px;height:34px;place-items:center;border-radius:5px;background:var(--green);color:var(--white);font-size:.72rem}.operator{display:flex;align-items:center;gap:18px;color:var(--muted);font-size:.88rem}
  main{min-height:calc(100vh - 64px)}.access{display:grid;grid-template-columns:minmax(280px,.8fr) minmax(380px,1fr);min-height:calc(100vh - 64px)}.access-heading{display:flex;flex-direction:column;justify-content:center;padding:clamp(48px,8vw,110px);background:var(--green);color:var(--white)}.eyebrow{margin:0 0 8px;color:var(--gold);font-size:.75rem;font-weight:850;text-transform:uppercase}.access h1,.workspace h1{margin:0;letter-spacing:0}.access h1{font-family:Georgia,"Times New Roman",serif;font-size:4rem;font-weight:500}.access-heading>p:last-child{max-width:430px;color:#d7e3df}.access-tool{align-self:center;width:min(460px,calc(100% - 40px));margin:40px auto;border:1px solid var(--line);border-radius:7px;background:var(--white);padding:26px}
