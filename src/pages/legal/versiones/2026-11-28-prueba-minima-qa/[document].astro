---
import type { GetStaticPaths } from 'astro';
import VersionedLegalDocument from '../../../../components/VersionedLegalDocument.astro';
import { isSignupTrialQaSite, registrationLegalLinks, MINIMUM_SLA_QA_HREF, MINIMUM_SLA_QA_VERSION,
  SIGNUP_MINIMUM_ADDRESS_QA_VERSION, SIGNUP_MINIMUM_QA_VERSION, SIGNUP_TRIAL_QA_VERSION } from '../../../../lib/registration-legal';
import { signupMinimumSlaLegalPacket as packet, signupMinimumSlaLegalDocuments as documents,
  signupMinimumSlaLegalSha256, type SignupMinimumSlaLegalDocument } from '../../../../lib/signup-minimum-sla-legal';

export const getStaticPaths: GetStaticPaths = () => {
  registrationLegalLinks({ PUBLIC_SITE_URL: import.meta.env.PUBLIC_SITE_URL,
    PUBLIC_REGISTRATION_LEGAL_VERSION: import.meta.env.PUBLIC_REGISTRATION_LEGAL_VERSION });
  if (!isSignupTrialQaSite(import.meta.env.PUBLIC_SITE_URL)) return [];
  return documents.map(document => ({ params: { document: document.slug }, props: { document } }));
};
interface Props { document: SignupMinimumSlaLegalDocument; }
const { document } = Astro.props;
const related = [
  ...documents.filter(item => item.slug !== document.slug).map(item => ({ title: item.title, href: `/legal/versiones/${packet.version}/${item.slug}/` })),
  { title: 'Acuerdo de nivel de servicio (SLA/ANS)', href: MINIMUM_SLA_QA_HREF },
  { title: 'Términos completos del acuerdo de servicio', href: `/legal/versiones/${MINIMUM_SLA_QA_VERSION}/terminos/` },
  { title: 'Privacidad del acuerdo de servicio', href: `/legal/versiones/${MINIMUM_SLA_QA_VERSION}/privacidad/` },
  { title: 'Anexo de tratamiento por cuenta del cliente', href: `/legal/versiones/${MINIMUM_SLA_QA_VERSION}/tratamiento-por-cuenta-del-cliente/` },
  ...[SIGNUP_MINIMUM_ADDRESS_QA_VERSION, SIGNUP_MINIMUM_QA_VERSION, SIGNUP_TRIAL_QA_VERSION].flatMap(version =>
    ['terminos', 'privacidad'].map(slug => ({ title: `${slug === 'terminos' ? 'Términos' : 'Privacidad'} · ${version}`, href: `/legal/versiones/${version}/${slug}/` }))),
  { title: 'Términos · 2026-09-01', href: '/legal/terminos/' },
  { title: 'Privacidad · 2026-09-01', href: '/legal/privacidad/' },
];
---
<VersionedLegalDocument version={packet.version} scope={packet.scope} notice={packet.notice}
  packageSha256={signupMinimumSlaLegalSha256} document={document} kind="registration" related={related} slaHref={MINIMUM_SLA_QA_HREF} />
