---
import FlowLayout from "../../layouts/FlowLayout.astro";
const apiUrl = import.meta.env.PUBLIC_SAAS_API_URL ?? "http://localhost:4100";
---
<FlowLayout title="Verificar correo" eyebrow="Verificación" heading="Confirma tu correo" lead="Validaremos el enlace antes de preparar el pago seguro.">
  <div class="result" id="verification" data-api-url={apiUrl}>
    <p class="status" role="status" aria-live="polite">Validando el enlace…</p>
    <div class="actions" hidden><a class="button" id="checkout-link" href="#">Continuar al pago seguro</a></div>
    <div class="actions"><button class="button secondary" type="button" id="renew-local" hidden>Renovar enlace de prueba</button></div>
  </div>
  <script>
    import { createIdempotencyKey } from "../../scripts/client-idempotency";
    import { withCheckoutReturn } from "../../lib/checkout-return";

    const root = document.querySelector<HTMLElement>("#verification")!;
    const status = root.querySelector<HTMLElement>(".status")!;
    const actions = root.querySelector<HTMLElement>(".actions")!;
    const link = root.querySelector<HTMLAnchorElement>("#checkout-link")!;
    const renew = root.querySelector<HTMLButtonElement>("#renew-local")!;
    const params = new URLSearchParams(location.search);
    const token = params.get("token");
    const signupIntentId = params.get("signupIntentId");
    const apiUrl = root.dataset.apiUrl?.replace(/\/$/, "") ?? "";
    type CheckoutView = { checkoutSessionId: string; checkoutUrl: string; provider: "wompi" | "local_demo" };
    const resumeCheckout = async (): Promise<CheckoutView> => {
      const response = await fetch(`${apiUrl}/v1/signup-intents/${encodeURIComponent(signupIntentId!)}/resume-checkout`, {
        method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ token })
      });
      const body = await response.json();
      if (!response.ok) throw body;
      return { ...body, provider: "wompi" };
    };
    const fail = (message: string) => { status.textContent = message; status.dataset.state = "error"; };
    const renewLocalVerification = async () => {
      if (!signupIntentId) return false;
      const response = await fetch(`${apiUrl}/v1/development/signup-intents/${encodeURIComponent(signupIntentId)}/verification`, {
        method: "POST"
      });
      const body = await response.json();
      if (!response.ok || typeof body?.verificationUrl !== "string") return false;
      const url = new URL(body.verificationUrl);
      if (url.origin !== location.origin || url.pathname !== "/registro/verificar") return false;
      status.textContent = "El enlace local fue renovado. Validando…";
      location.replace(url.href);
      return true;
    };
    renew.addEventListener("click", async () => {
      if (!import.meta.env.DEV) return;
      renew.disabled = true;
      try {
        if (!await renewLocalVerification()) fail("No fue posible renovar el enlace de prueba. Vuelve a iniciar el registro local.");
      } catch {
        fail("No fue posible renovar el enlace de prueba. Intenta nuevamente más tarde.");
      } finally { renew.disabled = false; }
    });
    if (!token || !signupIntentId) fail("El enlace está incompleto. Solicita uno nuevo.");
    else (async () => {
      try {
        let resumed: CheckoutView | null = null;
        // Local storage is never proof that a token/order is still eligible.
        // Only verification in this execution may authorize checkout creation.
        const verification = await fetch(`${apiUrl}/v1/signup-intents/${encodeURIComponent(signupIntentId)}/verify-email`, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ token }) });
        const verified = await verification.json();
        if (!verification.ok) {
          if (verified?.error?.code !== "invalid_or_expired_token") throw verified;
          resumed = await resumeCheckout();
        }
        status.textContent = "Correo confirmado. Estamos preparando tu orden…";
        const keyName = `checkout-key:${signupIntentId}`;
        let checkoutBody = resumed;
        if (!checkoutBody) {
          let key = createIdempotencyKey();
          try { key = sessionStorage.getItem(keyName) || key; sessionStorage.setItem(keyName, key); } catch { /* Storage is optional. */ }
          const checkout = await fetch(`${apiUrl}/v1/checkout-sessions`, { method: "POST", headers: { "content-type": "application/json", "idempotency-key": key }, body: JSON.stringify({ signupIntentId }) });
          const body = await checkout.json();
          if (!checkout.ok) {
            if (checkout.status !== 409) throw body;
            checkoutBody = await resumeCheckout();
          } else checkoutBody = body as CheckoutView;
        }
        try {
          sessionStorage.setItem("checkout-session-id", checkoutBody.checkoutSessionId);
          sessionStorage.setItem("checkout-provider", checkoutBody.provider);
        } catch { /* The return URL carries the checkout id across tabs. */ }
        link.href = checkoutBody.provider === "wompi"
          ? withCheckoutReturn(checkoutBody.checkoutUrl, checkoutBody.checkoutSessionId, location.origin)
          : checkoutBody.checkoutUrl;
        const localDemo = checkoutBody.provider === "local_demo";
        link.textContent = localDemo ? "Continuar al pago de prueba" : "Continuar al pago seguro";
        status.textContent = localDemo
          ? "Tu orden está lista. Puedes aprobar un pago local sin usar una tarjeta."
          : "Tu orden está lista. El pago se realiza directamente en Wompi.";
        status.dataset.state = "success";
        actions.hidden = false;
      } catch (error) {
        const message = typeof error === "object" && error && "error" in error ? (error as { error?: { message?: string } }).error?.message : null;
        const code = typeof error === "object" && error && "error" in error ? (error as { error?: { code?: string } }).error?.code : null;
        renew.hidden = !(import.meta.env.DEV && code === "invalid_or_expired_token");
        fail(message ?? "No pudimos validar el enlace. Puede haber vencido o ya fue utilizado.");
      }
    })();
  </script>
</FlowLayout>
