---
import FlowLayout from "../../layouts/FlowLayout.astro";
const apiUrl = import.meta.env.PUBLIC_SAAS_API_URL ?? "http://localhost:4100";
---
<FlowLayout title="Crear cuenta" eyebrow="Alta SaaS" heading="Prepara tu empresa" lead="Elige el plan, confirma tus datos y valida tu correo antes del pago.">
  <form class="flow-form" id="signup-form" data-api-url={apiUrl}>
    <div class="field"><label for="contactName">Nombre completo</label><input id="contactName" name="contactName" autocomplete="name" minlength="2" maxlength="180" required /></div>
    <div class="field"><label for="email">Correo</label><input id="email" name="email" type="email" autocomplete="email" maxlength="320" required /></div>
    <div class="field"><label for="companyName">Empresa</label><input id="companyName" name="companyName" autocomplete="organization" minlength="2" maxlength="200" required /></div>
    <div class="field"><label for="phone">Teléfono</label><input id="phone" name="phone" type="tel" autocomplete="tel" minlength="5" maxlength="40" /></div>
    <div class="field full"><label for="priceCode">Plan</label><select id="priceCode" name="priceCode" required><optgroup label="Sin facturación electrónica"><option value="basic">Básico · $49.900/mes</option><option value="professional">Profesional · $79.900/mes</option><option value="enterprise">Empresarial · $129.900/mes</option></optgroup><optgroup label="Con facturación electrónica"><option value="basic-fe">Básico FE · $69.900/mes</option><option value="professional-fe">Profesional FE · $99.900/mes</option><option value="enterprise-fe">Empresarial FE · $159.900/mes</option></optgroup></select></div>
    <label class="legal-check"><input id="legal" type="checkbox" required disabled /><span>Acepto los <a id="terms-link" href="/legal/terminos" target="_blank" rel="noopener">términos</a> y la <a id="privacy-link" href="/legal/privacidad" target="_blank" rel="noopener">política de privacidad</a> vigentes.</span></label>
    <div class="actions"><button class="button" type="submit" disabled>Continuar</button></div>
    <p class="status" role="status" aria-live="polite">Consultando condiciones vigentes…</p>
  </form>
  <script>
    type LegalDocument = { type: "terms" | "privacy"; version: string; contentUrl: string };
    const form = document.querySelector<HTMLFormElement>("#signup-form");
    const status = form?.querySelector<HTMLElement>(".status");
    const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
    const legal = form?.querySelector<HTMLInputElement>("#legal");
    const plan = form?.querySelector<HTMLSelectElement>("#priceCode");
    const apiUrl = form?.dataset.apiUrl?.replace(/\/$/, "") ?? "";
    let documents: LegalDocument[] = [];
    const setStatus = (message: string, state = "") => { if (status) { status.textContent = message; status.dataset.state = state; } };
    const errorMessage = (value: unknown) => {
      if (typeof value === "object" && value && "error" in value) {
        const error = (value as {
          error?: { message?: string; issues?: Array<{ path?: string; message?: string }> };
        }).error;
        const issues = error?.issues
          ?.map((issue) => issue.message ? `${issue.path ? `${issue.path}: ` : ""}${issue.message}` : "")
          .filter(Boolean);
        if (issues?.length) return issues.join(" ");
        if (error?.message) return error.message;
      }
      return "No fue posible completar la solicitud. Intenta de nuevo.";
    };

    const resetInvalidAttempt = () => {
      sessionStorage.removeItem("signup-draft");
      sessionStorage.removeItem("signup-accepted-at");
      sessionStorage.removeItem("signup-key");
    };
    const showLocalResume = (verificationUrl: string) => {
      const url = new URL(verificationUrl);
      if (url.origin !== location.origin || url.pathname !== "/registro/verificar") return;
      const existing = form?.querySelector<HTMLElement>("[data-local-resume]");
      if (existing) existing.remove();
      const resume = document.createElement("p");
      resume.className = "status";
      resume.dataset.state = "success";
      resume.dataset.localResume = "true";
      resume.append("Tienes un registro local pendiente. ");
      const link = document.createElement("a");
      link.href = url.href;
      link.textContent = "Continuar verificación";
      resume.append(link, ".");
      status?.after(resume);
    };
    const restoreLocalSignup = async () => {
      const signupIntentId = sessionStorage.getItem("signup-intent-id");
      if (!signupIntentId) return;
      try {
        const response = await fetch(`${apiUrl}/v1/development/signup-intents/${encodeURIComponent(signupIntentId)}/verification`);
        const body = await response.json();
        if (response.ok && typeof body?.verificationUrl === "string") showLocalResume(body.verificationUrl);
      } catch {
        // The standard registration form remains usable if no local continuation is available.
      }
    };
    const selected = new URLSearchParams(location.search).get("plan");
    if (plan && ["basic", "professional", "enterprise", "basic-fe", "professional-fe", "enterprise-fe"].includes(selected ?? "")) plan.value = selected!;
    fetch(`${apiUrl}/v1/public/legal-documents`)
      .then(async (response) => {
        const body = await response.json();
        if (!response.ok) throw body;
        documents = body.documents;
        const terms = documents.find((item) => item.type === "terms");
        const privacy = documents.find((item) => item.type === "privacy");
        if (!terms || !privacy) throw new Error("missing legal documents");
        const termsLink = document.querySelector<HTMLAnchorElement>("#terms-link");
        const privacyLink = document.querySelector<HTMLAnchorElement>("#privacy-link");
        if (termsLink) termsLink.href = new URL(terms.contentUrl, location.origin).toString();
        if (privacyLink) privacyLink.href = new URL(privacy.contentUrl, location.origin).toString();
        if (legal) legal.disabled = false;
        if (submit) submit.disabled = false;
        setStatus(`Condiciones vigentes: ${terms.version}.`);
      })
      .catch(() => setStatus("No pudimos consultar las condiciones vigentes. Recarga la página.", "error"));
    void restoreLocalSignup();
    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!form.reportValidity() || documents.length < 2) return;
      const data = new FormData(form);
      const terms = documents.find((item) => item.type === "terms")!;
      const privacy = documents.find((item) => item.type === "privacy")!;
      const draft = {
        contactName: String(data.get("contactName") ?? ""), email: String(data.get("email") ?? ""),
        companyName: String(data.get("companyName") ?? ""), phone: String(data.get("phone") ?? "") || undefined,
        priceCode: String(data.get("priceCode") ?? "professional")
      };
      const legalAcceptance = { termsVersion: terms.version, privacyVersion: privacy.version };
      const fingerprint = JSON.stringify({ ...draft, legalAcceptance });
      const previous = sessionStorage.getItem("signup-draft");
      const signupKey = sessionStorage.getItem("signup-key");
      if (
        previous !== fingerprint
        || !sessionStorage.getItem("signup-accepted-at")
        || !signupKey
        || signupKey.length < 16
      ) {
        sessionStorage.setItem("signup-draft", fingerprint);
        sessionStorage.setItem("signup-accepted-at", new Date().toISOString());
        sessionStorage.setItem("signup-key", crypto.randomUUID());
      }
      const payload = {
        ...draft,
        legalAcceptance: {
          ...legalAcceptance,
          acceptedAt: sessionStorage.getItem("signup-accepted-at")!
        }
      };
      submit!.disabled = true;
      setStatus("Creando tu registro…");
      try {
        const response = await fetch(`${apiUrl}/v1/signup-intents`, { method: "POST", headers: { "content-type": "application/json", "idempotency-key": sessionStorage.getItem("signup-key")! }, body: JSON.stringify(payload) });
        const body = await response.json();
        if (!response.ok) throw body;
        sessionStorage.setItem("signup-intent-id", body.signupIntentId);
        form.replaceChildren();
        const result = document.createElement("div");
        result.className = "result";
        const label = document.createElement("p");
        label.className = "eyebrow";
        label.textContent = "Correo enviado";
        const heading = document.createElement("h2");
        heading.textContent = "Revisa tu bandeja";
        const message = document.createElement("p");
        message.append("Enviamos el enlace de verificación a ");
        const email = document.createElement("strong");
        email.textContent = body.email;
        message.append(email, ". El registro continuará desde ese enlace.");
        result.append(label, heading, message);
        if (typeof body.developmentVerificationUrl === "string") {
          label.textContent = "Modo local";
          heading.textContent = "Registro creado";
          message.lastChild!.textContent = ". Continúa con la verificación local para probar el recorrido completo.";
          const actions = document.createElement("div");
          actions.className = "actions";
          const link = document.createElement("a");
          link.className = "button";
          link.href = body.developmentVerificationUrl;
          link.textContent = "Continuar verificación";
          actions.append(link);
          result.append(actions);
        }
        form.append(result);
      } catch (error) {
        submit!.disabled = false;
        if (
          typeof error === "object" && error && "error" in error
          && (error as { error?: { code?: string } }).error?.code === "invalid_request"
        ) resetInvalidAttempt();
        setStatus(errorMessage(error), "error");
      }
    });
  </script>
</FlowLayout>
