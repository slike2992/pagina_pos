---
import FlowLayout from "../../layouts/FlowLayout.astro";
const apiUrl = import.meta.env.PUBLIC_SAAS_API_URL ?? "http://localhost:4100";
---
<FlowLayout title="Crear cuenta" eyebrow="Empieza con Cripton" heading="Prueba gratis durante 15 días" lead="Elige tu plan y verifica tu correo. No necesitas tarjeta para la prueba; no se cobra ni renueva automáticamente. Los 15 días empiezan cuando tu empresa esté lista.">
  <form class="flow-form" id="signup-form" data-api-url={apiUrl}>
    <div class="field"><label for="contactName">Nombre completo (obligatorio)</label><input id="contactName" name="contactName" autocomplete="name" minlength="2" maxlength="180" required /></div>
    <div class="field"><label for="email">Correo (obligatorio)</label><input id="email" name="email" type="email" autocomplete="email" maxlength="320" required /></div>
    <div class="field"><label for="companyName">Empresa (obligatorio)</label><input id="companyName" name="companyName" autocomplete="organization" minlength="2" maxlength="200" required /></div>
    <div class="field"><label for="phone">Teléfono (obligatorio)</label><input id="phone" name="phone" type="tel" autocomplete="tel" minlength="8" maxlength="40" required aria-describedby="phone-help" /><p id="phone-help" class="status">Incluye el indicativo de país; en Colombia, +57 y diez dígitos. Dar tu teléfono no autoriza mensajes por WhatsApp.</p></div>
    <div class="field full"><label for="priceCode">Plan (obligatorio)</label><select id="priceCode" name="priceCode" required><optgroup label="Sin facturación electrónica"><option value="basic">Básico · $49.900/mes</option><option value="professional">Profesional · $79.900/mes</option><option value="enterprise">Empresarial · $129.900/mes</option></optgroup><optgroup label="Con facturación electrónica"><option value="basic-fe">Básico FE · $69.900/mes</option><option value="professional-fe">Profesional FE · $99.900/mes</option><option value="enterprise-fe">Empresarial FE · $159.900/mes</option></optgroup></select></div>
    <p>Puedes contratar el plan en cualquier momento, también durante la prueba, y conservar el tiempo gratis restante. La disponibilidad electrónica requiere configurar el emisor y el ambiente fiscal.</p>
    <label class="legal-check"><input id="legal" type="checkbox" required disabled /><span>Acepto los <a id="terms-link" href="/legal/terminos" target="_blank" rel="noopener">términos</a> y la <a id="privacy-link" href="/legal/privacidad" target="_blank" rel="noopener">política de privacidad</a> vigentes. (obligatorio)</span></label>
    <div class="actions"><button class="button" type="submit" disabled>Continuar</button></div>
    <p class="status" role="status" aria-live="polite">Consultando condiciones vigentes…</p>
  </form>
  <script>
    import { bindFormFeedback } from "../../lib/form-feedback";
    import { createIdempotencyKey } from "../../scripts/client-idempotency";
    import { normalizeSignupPhone } from "../../lib/signup-phone";

    import { readPendingSignup, createdPendingSignup, savePendingSignup, showVerificationInbox } from "../../lib/signup-verification";

    type LegalDocument = { type: "terms" | "privacy"; version: string; contentUrl: string };
    const form = document.querySelector<HTMLFormElement>("#signup-form");
    const feedback = form ? bindFormFeedback(form) : null;
    const status = form?.querySelector<HTMLElement>(".status");
    const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
    const legal = form?.querySelector<HTMLInputElement>("#legal");
    const plan = form?.querySelector<HTMLSelectElement>("#priceCode");
    const apiUrl = form?.dataset.apiUrl?.replace(/\/$/, "") ?? "";
    let documents: LegalDocument[] = [];
    const setStatus = (message: string, state = "") => { if (status) { status.textContent = message; status.dataset.state = state; } };
    const errorMessage = (value: unknown) => {
      if (typeof value === "object" && value && "error" in value) {
        const error = (value as {
          error?: { message?: string; issues?: Array<{ path?: string; message?: string }> };
        }).error;
        const issues = error?.issues
          ?.map((issue) => issue.message ? `${issue.path ? `${issue.path}: ` : ""}${issue.message}` : "")
          .filter(Boolean);
        if (issues?.length) return issues.join(" ");
        if (error?.message) return error.message;
      }
      return "No fue posible completar la solicitud. Intenta de nuevo.";
    };

    let attempt: { fingerprint: string; key: string; acceptedAt: string } | null = null;
    const pending = readPendingSignup();
    if (form && pending) {
      form.addEventListener("submit", (event) => event.preventDefault());
      if (import.meta.env.DEV) {
        // Read-only local continuation. Staging/production never query development routes.
        void fetch(`${apiUrl}/v1/development/signup-intents/${encodeURIComponent(pending.id)}/verification`)
          .then(async (response) => response.ok ? (await response.json()).verificationUrl : undefined)
          .then((url) => showVerificationInbox(form, apiUrl, pending, typeof url === "string" ? url : undefined, false))
          .catch(() => showVerificationInbox(form, apiUrl, pending, undefined, false));
      } else showVerificationInbox(form, apiUrl, pending, undefined, false);
    } else {
      // Preserve the original creation key after a lost response or reload.
      try {
        const fingerprint = sessionStorage.getItem("signup-draft"), key = sessionStorage.getItem("signup-key"), acceptedAt = sessionStorage.getItem("signup-accepted-at");
        if (fingerprint && key && key.length >= 16 && key.length <= 100 && acceptedAt && Number.isFinite(Date.parse(acceptedAt)))
          attempt = { fingerprint, key, acceptedAt };
      } catch { /* Current-page retry still works when storage is unavailable. */ }
      const selected = new URLSearchParams(location.search).get("plan");
      if (plan && ["basic", "professional", "enterprise", "basic-fe", "professional-fe", "enterprise-fe"].includes(selected ?? "")) plan.value = selected!;
      const clearAttempt = () => {
        attempt = null;
        try { for (const key of ["signup-draft", "signup-key", "signup-accepted-at"]) sessionStorage.removeItem(key); } catch { /* Storage optional. */ }
      };
      const loadLegalDocuments = async (acceptanceNotice = "") => {
        documents = [];
        if (legal) legal.disabled = true;
        if (submit) submit.disabled = true;
        const response = await fetch(`${apiUrl}/v1/public/legal-documents`, { cache: "no-store" });
        const body = await response.json();
        if (!response.ok) throw body;
        const currentDocuments: LegalDocument[] = body.documents;
        if (!Array.isArray(currentDocuments)) throw new Error("missing legal documents");
        const terms = currentDocuments.find((item) => item.type === "terms");
        const privacy = currentDocuments.find((item) => item.type === "privacy");
        if (!terms || !privacy) throw new Error("missing legal documents");
        const termsLink = document.querySelector<HTMLAnchorElement>("#terms-link");
        const privacyLink = document.querySelector<HTMLAnchorElement>("#privacy-link");
        if (termsLink) termsLink.href = new URL(terms.contentUrl, location.origin).toString();
        if (privacyLink) privacyLink.href = new URL(privacy.contentUrl, location.origin).toString();
        documents = currentDocuments;
        if (legal) legal.disabled = false;
        if (submit) submit.disabled = false;
        setStatus(acceptanceNotice
          ? `${acceptanceNotice} Consulta las condiciones vigentes (${terms.version}) y vuelve a aceptarlas para continuar.`
          : `Condiciones vigentes: ${terms.version}.`);
      };
      void loadLegalDocuments()
        .catch(() => setStatus("No pudimos consultar las condiciones vigentes. Recarga la página.", "error"));
      form?.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!feedback?.validate() || documents.length < 2 || !legal || legal.disabled || !legal.checked || submit?.disabled) return;
        const data = new FormData(form);
        const phone = normalizeSignupPhone(String(data.get("phone") ?? ""));
        if (!phone) {
          setStatus("Ingresa un teléfono válido con indicativo de país; en Colombia, +57 y diez dígitos.", "error");
          form.querySelector<HTMLInputElement>("#phone")?.focus();
          return;
        }
        const terms = documents.find((item) => item.type === "terms")!;
        const privacy = documents.find((item) => item.type === "privacy")!;
        const draft = {
          contactName: String(data.get("contactName") ?? ""), email: String(data.get("email") ?? ""),
          companyName: String(data.get("companyName") ?? ""), phone,
          priceCode: String(data.get("priceCode") ?? "professional")
        };
        const legalAcceptance = { termsVersion: terms.version, privacyVersion: privacy.version };
        let fingerprint = JSON.stringify({ ...draft, legalAcceptance });
        // An in-flight pre-upgrade request may contain a formatted phone. Keep
        // its original bytes/key when only formatting or property order differs.
        if (attempt) try {
          const previous = JSON.parse(attempt.fingerprint);
          if (typeof previous.phone === "string" && normalizeSignupPhone(previous.phone) === phone
            && ["contactName", "email", "companyName", "priceCode"].every((field) => previous[field] === draft[field as keyof typeof draft])
            && previous.legalAcceptance?.termsVersion === legalAcceptance.termsVersion
            && previous.legalAcceptance?.privacyVersion === legalAcceptance.privacyVersion) {
            draft.phone = previous.phone;
            fingerprint = attempt.fingerprint;
          }
        } catch { /* An invalid stored draft cannot authorize a replay. */ }
        if (!attempt || attempt.fingerprint !== fingerprint) {
          attempt = { fingerprint, key: createIdempotencyKey(), acceptedAt: new Date().toISOString() };
          try {
            sessionStorage.setItem("signup-draft", fingerprint); sessionStorage.setItem("signup-key", attempt.key); sessionStorage.setItem("signup-accepted-at", attempt.acceptedAt);
          } catch { /* Storage is optional; preserve this attempt in memory. */ }
        }
        const payload = {
          ...draft,
          legalAcceptance: {
            ...legalAcceptance,
            acceptedAt: attempt.acceptedAt
          }
        };
        submit!.disabled = true;
        setStatus("Creando tu registro…");
        try {
          const response = await fetch(`${apiUrl}/v1/signup-intents`, { method: "POST", headers: { "content-type": "application/json", "idempotency-key": attempt.key }, body: JSON.stringify(payload) });
          const body = await response.json();
          if (!response.ok && response.status === 409 && body?.error?.code === "signup_legal_acceptance_stale") {
            clearAttempt();
            legal.checked = false;
            const acceptanceNotice = errorMessage(body);
            setStatus(`${acceptanceNotice} Actualizando las condiciones vigentes. Tendrás que revisarlas y aceptarlas de nuevo.`);
            try { await loadLegalDocuments(acceptanceNotice); }
            catch { setStatus(`${acceptanceNotice} No pudimos actualizar las condiciones vigentes. Conservamos tus datos; recarga la página y vuelve a revisarlas y aceptarlas.`, "error"); }
            return;
          }
          if (!response.ok) throw body;
          const pending = createdPendingSignup(body);
          savePendingSignup(pending);
          attempt = null;
          showVerificationInbox(form, apiUrl, pending, typeof body.developmentVerificationUrl === "string" ? body.developmentVerificationUrl : undefined);
        } catch (error) {
          submit!.disabled = false;
          if (
            typeof error === "object" && error && "error" in error
            && (error as { error?: { code?: string } }).error?.code === "invalid_request"
          ) {
            clearAttempt();
          }
          const deliveryUnavailable = typeof error === "object" && error && "error" in error
            && (error as { error?: { code?: string } }).error?.code === "email_delivery_unavailable";
          setStatus(deliveryUnavailable
            ? `${errorMessage(error)} Conservamos los datos del formulario. Intenta nuevamente más tarde para continuar la verificación.`
            : errorMessage(error), "error");
        }
      });
    }
  </script>
</FlowLayout>
