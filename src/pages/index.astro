---
import { Picture } from "astro:assets";
import heroImage from "../assets/hero-comercio-pos.png";
import "../styles/base.css";
import "../styles/landing.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SeoHead from "../components/SeoHead.astro";
import { SITE_URL } from "../lib/seo";

const formatCOP = (value: number) => new Intl.NumberFormat("es-CO", { style: "currency", currency: "COP", maximumFractionDigits: 0 }).format(value);
const planSaving = (plan: { monthly: string; annual: string }) => formatCOP(Number(plan.monthly.replace(/\D/g, "")) * 12 - Number(plan.annual.replace(/\D/g, "")));
const moduleLinks = ["/soluciones/ventas-y-caja/", "/soluciones/ventas-y-caja/", "/soluciones/inventario/", "/soluciones/reportes/", "/confianza/", "/soluciones/inventario/"];
const commercialEmail = "ventas@cripton.com.co";

const seoTitle = "Software POS en Colombia: ventas e inventario | Cripton";
const seoDescription = "Cripton es un software POS web para comercios en Colombia. Gestiona ventas, caja, inventario, usuarios y reportes. Conoce los planes y agenda una demostración.";

const whatsappNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER?.replace(/\D/g, "") ?? "";

const modules = [
  { number: "01", title: "Ventas ágiles", text: "Registra productos, cantidades y medios de pago desde un flujo pensado para atender sin fricción." },
  { number: "02", title: "Control de caja", text: "Organiza aperturas, cierres, movimientos y arqueos para entender cada turno con claridad." },
  { number: "03", title: "Inventario al día", text: "Consulta existencias y movimientos para anticipar faltantes y comprar con mejor información." },
  { number: "04", title: "Reportes útiles", text: "Revisa ventas, caja e inventario con indicadores claros para tomar decisiones oportunas." },
  { number: "05", title: "Usuarios y permisos", text: "Asigna responsabilidades y controla el acceso de cada persona según su función." },
  { number: "06", title: "Operación multisede", text: "Prepara el crecimiento de tu negocio con sucursales, cajas y control centralizado." },
];

const planCatalog = [
  {
    code: "basic",
    name: "Básico",
    summary: "Para empezar a vender con orden y controlar lo esencial del negocio.",
    monthly: "$49.900",
    annual: "$499.000",

    users: "1 usuario",
    branches: "1 sucursal",
    registers: "1 caja",
    items: "Hasta 1.000 ítems",
    features: ["Ventas y caja", "Productos e inventario básico", "Reportes esenciales", "Soporte por chat", "Acompañamiento de arranque"],
    cta: "Elegir Básico",
    highlighted: false,
  },
  {
    code: "professional",
    name: "Profesional",
    summary: "Para negocios en crecimiento que necesitan más control operativo y mejores reportes.",
    monthly: "$79.900",
    annual: "$799.000",

    users: "Hasta 3 usuarios",
    branches: "2 sucursales",
    registers: "2 cajas, una por sucursal",
    items: "Hasta 5.000 ítems",
    features: ["Todo lo del plan Básico", "Usuarios y permisos", "Inventario avanzado", "Compras y proveedores", "Reportes avanzados", "Soporte prioritario"],
    cta: "Elegir Profesional",
    highlighted: true,
  },
  {
    code: "enterprise",
    name: "Empresarial",
    summary: "Para operaciones con varias sedes y necesidades de gestión avanzada.",
    monthly: "$129.900",
    annual: "$1.299.000",

    users: "Usuarios ilimitados",
    branches: "3 sucursales",
    registers: "Hasta 6 cajas, dos por sucursal",
    items: "Hasta 20.000 ítems",
    features: ["Todo lo del plan Profesional", "Permisos avanzados", "Indicadores gerenciales", "Preparado para integraciones", "Soporte prioritario y acompañamiento"],
    cta: "Elegir Empresarial",
    highlighted: false,
  },
] as const;

const electronicInvoicingPlans = [
  {
    ...planCatalog[0],
    code: "basic-fe",
    name: "Básico FE",
    summary: "Vende y factura electrónicamente desde el inicio, con una operación sencilla.",
    monthly: "$69.900",
    annual: "$699.000",

    documents: "Hasta 1.000 documentos electrónicos al año",
    cta: "Elegir Básico FE",
  },
  {
    ...planCatalog[1],
    code: "professional-fe",
    name: "Profesional FE",
    summary: "Mayor control, mejores reportes y facturación electrónica para equipos en crecimiento.",
    monthly: "$99.900",
    annual: "$999.000",

    documents: "Hasta 2.000 documentos electrónicos al año",
    cta: "Elegir Profesional FE",
  },
  {
    ...planCatalog[2],
    code: "enterprise-fe",
    name: "Empresarial FE",
    summary: "Control multisede y facturación electrónica para operaciones de alto volumen.",
    monthly: "$159.900",
    annual: "$1.599.000",

    documents: "Documentos electrónicos ilimitados",
    cta: "Elegir Empresarial FE",
  },
] as const;

const plans = [...planCatalog, ...electronicInvoicingPlans];

const comparisons = [
  ["Usuarios", "1", "Hasta 3", "Ilimitados"],
  ["Sucursales", "1", "2", "3"],
  ["Cajas", "1", "2", "Hasta 6"],
  ["Ítems de inventario", "Hasta 1.000", "Hasta 5.000", "Hasta 20.000"],
  ["Inventario", "Esencial", "Avanzado", "Avanzado"],
  ["Reportes", "Esenciales", "Avanzados", "Gerenciales"],
];

const faqs = [
  ["¿Puedo conocer el sistema antes de contratar?", "Sí. Coordinamos una demostración enfocada en el flujo real de tu negocio para que puedas evaluar ventas, caja, inventario y reportes."],
  ["¿Necesito instalar el sistema en cada equipo?", "La plataforma está pensada para operar en la web. Durante la implementación revisamos tus equipos, conexión y necesidades para definir la configuración adecuada."],
  ["¿Qué incluye la implementación inicial?", "Revisamos los datos, equipos y pasos necesarios para iniciar. El alcance y cualquier costo de acompañamiento deben confirmarse antes de contratar; no se añade un cargo desde este formulario."],
  ["¿Puedo cambiar de plan más adelante?", "Sí. La estructura está preparada para acompañar el crecimiento del negocio y ajustar capacidades cuando la operación lo requiera."],
  ["¿Los precios publicados son definitivos?", "Los planes muestran su valor mensual y anual en pesos colombianos. Revisa la periodicidad, los límites y el desglose de impuestos que se te presente antes de confirmar el pago."],
  ["¿Contratar un plan FE activa la emisión inmediatamente?", "La emisión requiere preparar el emisor, la numeración y el ambiente correspondiente. El pago del plan no reemplaza esa configuración ni la habilitación fiscal necesaria."],
  ["¿Qué necesito para trabajar desde un navegador?", "Una conexión y equipos compatibles con el flujo de tu negocio. En la demostración revisamos los periféricos que utilizas; no asumas funcionamiento sin conexión ni compatibilidad con toda impresora."],
];

const siteSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${SITE_URL}/#organization`,
      name: "Cripton",
      url: `${SITE_URL}/`,
      email: commercialEmail,
      contactPoint: {
        "@type": "ContactPoint",
        contactType: "sales",
        email: commercialEmail,
      },
      logo: new URL("/brand/v1.0/cripton_horizontal_color_v1.0.svg", SITE_URL).href,
    },
    {
      "@type": "WebSite",
      "@id": `${SITE_URL}/#website`,
      name: "Cripton",
      alternateName: "Cripton POS",
      url: `${SITE_URL}/`,
      inLanguage: "es-CO",
      publisher: { "@id": `${SITE_URL}/#organization` },
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${SITE_URL}/#software`,
      name: "Cripton POS",
      url: `${SITE_URL}/`,
      applicationCategory: "BusinessApplication",
      operatingSystem: "Web",
      description: seoDescription,
      publisher: { "@id": `${SITE_URL}/#organization` },
      offers: plans.map((plan) => ({
        "@type": "Offer",
        name: `Plan ${plan.name}, mensual`,
        url: `${SITE_URL}/#planes`,
        price: plan.monthly.replace(/[$.]/g, ""),
        priceCurrency: "COP",
      })),
    },
  ],
};
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead title={seoTitle} description={seoDescription} />
    <meta name="theme-color" content="#051828" />
    <link rel="icon" type="image/svg+xml" href="/brand/v1.0/favicon.svg" />
    <link rel="icon" href="/brand/v1.0/favicon.ico" sizes="any" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(siteSchema).replace(/</g, "\\u003c")} />
  </head>
  <body class="landing-page">
    <SiteHeader />

    <main id="contenido" tabindex="-1">
      <section class="hero" id="inicio">
        <Picture class="hero-image" src={heroImage} alt="Comerciante usando un terminal de punto de venta en su tienda" widths={[768, 1280, 1920]} sizes="100vw" formats={["avif", "webp"]} fallbackFormat="webp" loading="eager" fetchpriority="high" />
        <div class="hero-shade" aria-hidden="true"></div>
        <div class="hero-content">
          <p class="eyebrow light">Control para comercios que quieren crecer</p>
          <h1>Software POS para comercios en Colombia.</h1>
          <p class="hero-lead">Para tiendas, papelerías y comercios especializados: vende con agilidad, organiza tu caja y conoce tu inventario en una sola plataforma.</p>
          <div class="hero-actions" aria-label="Acciones principales">
            <a class="button primary light-button" href="#planes" data-track="plans" data-track-location="hero">Ver planes para mi negocio</a>
            <a class="text-link light-link" href="#contacto" data-track="demo" data-track-location="hero">Solicitar una demostración <span aria-hidden="true">→</span></a>
          </div>
          <p class="hero-note">Planes desde <strong>$49.900 al mes</strong> · Implementación acompañada</p>
        </div>
      </section>

      <section class="proof-strip" aria-label="Beneficios principales">
        <p><strong>Una sola operación</strong><span>Ventas, caja e inventario conectados</span></p>
        <p><strong>Decisiones con datos</strong><span>Reportes claros y oportunos</span></p>
        <p><strong>Acompañamiento real</strong><span>Configuración y puesta en marcha</span></p>
      </section>

      <section class="intro section" id="solucion">
        <div class="section-heading split-heading">
          <div><p class="eyebrow">Menos tareas sueltas</p><h2>Todo lo importante, en el mismo lugar</h2></div>
          <p>Diseñado para que el equipo trabaje con rapidez y tú puedas entender qué pasa en el negocio sin reunir información de varias fuentes.</p>
        </div>
        <div class="outcomes">
          <article><span>01</span><h3>Atiende mejor</h3><p>Un flujo de venta claro reduce pasos y mantiene la operación en movimiento.</p></article>
          <article><span>02</span><h3>Controla cada turno</h3><p>Caja, movimientos y arqueos quedan organizados para facilitar el seguimiento.</p></article>
          <article><span>03</span><h3>Compra con criterio</h3><p>Las existencias y reportes te ayudan a anticipar necesidades reales del inventario.</p></article>
        </div>
      </section>

      <section class="product-section section dark-section" aria-labelledby="product-title">
        <div class="product-copy">
          <p class="eyebrow light">Una vista para actuar</p>
          <h2 id="product-title">La jornada completa, sin perder el hilo</h2>
          <p>Consulta el ticket actual, las alertas de inventario y el avance de ventas desde una experiencia consistente.</p>
          <ul class="check-list"><li>Información útil en el momento de la venta</li><li>Alertas visibles para actuar a tiempo</li><li>Indicadores fáciles de leer</li></ul>
        </div>
        <div class="product-visual" aria-label="Vista ilustrativa del tablero de Cripton">
          <div class="screen-top"><span aria-hidden="true"></span><strong>Venta en mostrador</strong><em>Ejemplo ilustrativo</em></div>
          <div class="pos-grid">
            <section class="ticket-panel"><h3>Ticket actual</h3><div class="line-item"><span>Café premium</span><strong>$18.000</strong></div><div class="line-item"><span>Pan artesanal</span><strong>$7.500</strong></div><div class="line-item"><span>Bebida fría</span><strong>$6.900</strong></div><div class="total-row"><span>Total</span><strong>$32.400</strong></div><span class="mock-control">Resumen de venta</span></section>
            <section class="stock-panel"><h3>Inventario</h3><div class="stock ok"><span>Arroz libra</span><strong>84</strong></div><div class="stock warn"><span>Azúcar</span><strong>9</strong></div><div class="stock ok"><span>Aceite</span><strong>31</strong></div></section>
            <section class="sales-panel"><p>Ventas de hoy</p><strong>$1.284.600</strong><div class="bars" aria-hidden="true"><span style="height:44%"></span><span style="height:72%"></span><span style="height:56%"></span><span style="height:86%"></span><span style="height:64%"></span></div></section>
          </div>
        </div>
      </section>

      <section class="modules-section section" id="modulos">
        <div class="section-heading"><p class="eyebrow">Capacidades</p><h2>Herramientas para la operación diaria</h2><p>Empieza por lo esencial y amplía el control a medida que tu negocio lo necesite.</p></div>
        <div class="module-list">{modules.map((module, index) => <article><span>{module.number}</span><div><h3>{module.title}</h3><p>{module.text}</p><a href={moduleLinks[index]} aria-label={`Conocer el flujo: ${module.title.toLowerCase()}`}>Conocer el flujo <span aria-hidden="true">→</span></a></div></article>)}</div>
      </section>

      <section class="steps-section section">
        <div class="section-heading"><p class="eyebrow">Puesta en marcha</p><h2>Del diagnóstico a la primera venta</h2></div>
        <ol class="steps"><li><span>1</span><div><h3>Conocemos tu operación</h3><p>Revisamos el tipo de negocio, los equipos y el flujo actual.</p></div></li><li><span>2</span><div><h3>Configuramos contigo</h3><p>Parametrizamos la solución y preparamos la información necesaria.</p></div></li><li><span>3</span><div><h3>Acompañamos el arranque</h3><p>Validamos el flujo y resolvemos dudas durante la puesta en marcha.</p></div></li></ol>
      </section>

      <section class="plans-section section" id="planes">
        <div class="section-heading centered"><p class="eyebrow">Planes</p><h2>Elige el nivel de control que necesitas</h2><p>Dos modalidades independientes para que contrates solo lo que tu operación necesita. Valores en pesos colombianos.</p></div>
        <div class="plan-group" aria-labelledby="plans-without-fe-title">
          <div class="plan-group-heading"><div><p class="eyebrow">Operación POS</p><h3 id="plans-without-fe-title">Planes sin facturación electrónica</h3></div><p>Ideales si ya tienes un proveedor de facturación o todavía no necesitas emitir documentos electrónicos.</p></div>
          <div class="plans-grid">{planCatalog.map((plan) => <article class:list={["plan-card", { highlighted: plan.highlighted }]}>{plan.highlighted && <span class="plan-badge">Recomendado</span>}<h4 class="plan-name">Plan {plan.name}</h4><div class="price"><strong>{plan.monthly}</strong><span>COP / mes</span></div><div class="annual-price"><strong>{plan.annual}</strong><span>COP / año</span><em>Ahorra {planSaving(plan)}</em></div><p>{plan.summary}</p><dl class="plan-limits"><div><dt>Usuarios</dt><dd>{plan.users}</dd></div><div><dt>Sucursales</dt><dd>{plan.branches}</dd></div><div><dt>Cajas</dt><dd>{plan.registers}</dd></div><div><dt>Inventario</dt><dd>{plan.items}</dd></div></dl><ul class="check-list">{plan.features.map((feature) => <li>{feature}</li>)}</ul><a class:list={["button plan-button", { primary: plan.highlighted }]} href={`/registro?plan=${plan.code}`} data-track="signup" data-track-location="plan" data-track-plan={plan.code}>{plan.cta}</a></article>)}</div>
        </div>
        <div class="plan-group plan-group-fe" aria-labelledby="plans-with-fe-title">
          <div class="plan-group-heading"><div><p class="eyebrow fe-eyebrow">Facturación electrónica</p><h3 id="plans-with-fe-title">Planes con facturación electrónica</h3></div><p>POS y facturación electrónica con límites claros. Emitir requiere preparar y habilitar el emisor, su numeración y el ambiente correspondiente.</p></div>
          <div class="plans-grid">{electronicInvoicingPlans.map((plan) => <article class:list={["plan-card", "fe-card", { highlighted: plan.highlighted }]}>{plan.highlighted && <span class="plan-badge">Recomendado</span>}<h4 class="plan-name">Plan {plan.name}</h4><div class="price"><strong>{plan.monthly}</strong><span>COP / mes</span></div><div class="annual-price"><strong>{plan.annual}</strong><span>COP / año</span><em>Ahorra {planSaving(plan)}</em></div><p>{plan.summary}</p><dl class="plan-limits"><div><dt>Usuarios</dt><dd>{plan.users}</dd></div><div><dt>Sucursales</dt><dd>{plan.branches}</dd></div><div><dt>Cajas</dt><dd>{plan.registers}</dd></div><div><dt>Inventario</dt><dd>{plan.items}</dd></div></dl><ul class="check-list"><li>Facturación electrónica incluida</li><li>{plan.documents}</li>{plan.features.map((feature) => <li>{feature}</li>)}</ul><a class:list={["button plan-button", { primary: plan.highlighted }]} href={`/registro?plan=${plan.code}`} data-track="signup" data-track-location="plan" data-track-plan={plan.code}>{plan.cta}</a></article>)}</div>
        </div>
        <p class="price-note">Los límites de usuarios, cajas, sucursales, ítems y documentos se aplican por empresa. El ahorro anual compara doce mensualidades con el valor anual publicado. Confirma la periodicidad y el desglose aplicable antes de pagar.</p>
      </section>

      <section class="comparison-section section" id="comparador">
        <div class="section-heading"><p class="eyebrow">Comparación</p><h2>Encuentra el plan adecuado</h2></div>
        <div class="comparison-scroll" tabindex="0" aria-label="Comparador de planes; desplázate horizontalmente si es necesario">
          <table><caption class="sr-only">Comparación de capacidades por plan</caption><thead><tr><th scope="col">Capacidad</th><th scope="col">Básico</th><th scope="col">Profesional</th><th scope="col">Empresarial</th></tr></thead><tbody>{comparisons.map(([feature, basic, pro, enterprise]) => <tr><th scope="row">{feature}</th><td>{basic}</td><td class="pro-cell">{pro}</td><td>{enterprise}</td></tr>)}</tbody></table>
        </div>
      </section>

      <section class="cta-band">
        <div><p class="eyebrow light">Decide con tranquilidad</p><h2>Conoce el sistema aplicado a tu negocio</h2><p>Agenda una conversación y revisemos juntos el flujo que hoy quieres mejorar.</p></div>
        <a class="button light-button" href="#contacto" data-track="demo" data-track-location="content">Quiero una demostración</a>
      </section>

      <section class="decision-section section" aria-labelledby="decision-title">
        <div class="section-heading"><p class="eyebrow">Evalúa antes de elegir</p><h2 id="decision-title">Resuelve las dudas que importan en tu negocio</h2><p>Conoce los requisitos, revisa el flujo y decide qué necesitas contratar.</p></div>
        <div class="decision-grid">
          <article class="decision-card"><h3>¿Qué debes probar en un POS?</h3><p>Una guía para revisar ventas, inventario, caja y costos con casos de tu jornada.</p><a href="/guias/elegir-un-pos/">Preparar mi evaluación</a></article>
          <article class="decision-card"><h3>¿Vas a facturar electrónicamente?</h3><p>Separa la elección del plan de la preparación del emisor y del ambiente de emisión.</p><a href="/soluciones/facturacion-electronica/">Revisar requisitos de emisión</a></article>
          <article class="decision-card"><h3>¿Cómo se cuida tu información?</h3><p>Conoce los accesos por empresa, las responsabilidades y los canales de atención.</p><a href="/confianza/">Consultar seguridad y condiciones</a></article>
        </div>
      </section>

      <section class="faq-section section" id="faq">
        <div class="section-heading"><p class="eyebrow">Preguntas frecuentes</p><h2>Lo que necesitas saber antes de empezar</h2></div>
        <div class="faq-list">{faqs.map(([question, answer]) => <details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div>
      </section>

      <section class="contact-section section" id="contacto">
        <div class="contact-copy"><p class="eyebrow light">Hablemos de tu operación</p><h2>Trae un caso de tu negocio a la demostración</h2><p>Cuéntanos qué vendes, cuántas personas usan el sistema y qué necesitas ordenar. Prepararemos el mensaje para que puedas revisarlo antes de enviarlo.</p><p>También puedes escribir a <a href={`mailto:${commercialEmail}`}>{commercialEmail}</a>.</p><dl><div><dt>Demostración</dt><dd>Recorrido según tu operación</dd></div><div><dt>Plan</dt><dd>Capacidades y requisitos claros</dd></div><div><dt>Arranque</dt><dd>Preparación de tus primeros pasos</dd></div></dl></div>
        <form class="lead-form" id="lead-form" data-whatsapp-number={whatsappNumber}>
          <div class="lead-field"><label for="name">Nombre (obligatorio)</label><input id="name" type="text" name="name" autocomplete="name" minlength="2" maxlength="120" required placeholder="Tu nombre" disabled /></div>
          <div class="lead-field"><label for="phone">Teléfono o WhatsApp (opcional)</label><input id="phone" type="tel" name="phone" autocomplete="tel" maxlength="40" inputmode="tel" placeholder="300 000 0000" disabled /></div>
          <div class="lead-field"><label for="plan">Plan de interés</label><select id="plan" name="plan" disabled>{plans.map(plan => <option value={plan.name} selected={plan.code === "professional"}>{plan.name}</option>)}</select></div>
          <div class="lead-field"><label for="message">¿Qué te gustaría mejorar?</label><textarea id="message" name="message" rows="4" maxlength="1500" placeholder="Por ejemplo: controlar inventario y cierres de caja" disabled></textarea></div>
          <button class="button" type="submit" disabled>Preparar mensaje para ventas</button>
          <p class="form-note">Este formulario prepara un mensaje en tu navegador. No almacena tus datos ni los envía automáticamente. El canal elegido tiene sus propias condiciones. <a href="/legal/privacidad/">Consulta privacidad</a>.</p>
          <p class="form-status" role="status" aria-live="polite"></p>
          <button class="button secondary contact-ready" data-contact-ready type="button" hidden></button>
          <noscript><p>Para solicitar una demostración escribe a <a href="mailto:ventas@cripton.com.co">ventas@cripton.com.co</a>. El formulario requiere JavaScript para preparar el mensaje sin enviar datos a esta página.</p></noscript>
        </form>
      </section>
    </main>

    <SiteFooter />
    <script>
      import { bindFormFeedback } from "../lib/form-feedback";
      const form = document.querySelector<HTMLFormElement>("#lead-form");
      form?.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | HTMLButtonElement>("input, select, textarea, button").forEach(control => { control.disabled = false; });
      const feedback = form ? bindFormFeedback(form) : null;
      const ready = form?.querySelector<HTMLButtonElement>("[data-contact-ready]");
      const status = form?.querySelector<HTMLElement>(".form-status");
      let preparedUrl = "";
      ready?.addEventListener("click", event => {
        event.stopPropagation();
        if (preparedUrl) window.open(preparedUrl, "_blank", "noopener,noreferrer");
      });
      form?.addEventListener("input", () => {
        if (preparedUrl && status) status.textContent = "Has cambiado los datos. Vuelve a preparar el mensaje para revisarlo.";
        preparedUrl = "";
        if (ready) ready.hidden = true;
      });
      form?.addEventListener("submit", event => {
        event.preventDefault();
        if (!feedback?.validate() || !ready) return;
        const data = new FormData(form);
        const lines = ["Hola, quiero agendar una demostración de Cripton.", `Nombre: ${String(data.get("name") ?? "").trim()}`, data.get("phone") ? `Teléfono: ${String(data.get("phone")).trim()}` : "", `Plan de interés: ${data.get("plan")}`, data.get("message") ? `Necesidad: ${String(data.get("message")).trim()}` : ""].filter(Boolean).join("\n");
        const number = form.dataset.whatsappNumber ?? "";
        preparedUrl = number ? `https://wa.me/${number}?text=${encodeURIComponent(lines)}` : `mailto:ventas@cripton.com.co?subject=${encodeURIComponent("Demostración de Cripton POS")}&body=${encodeURIComponent(lines)}`;
        ready.textContent = number ? "Revisar y abrir mi mensaje en WhatsApp" : "Revisar y abrir mi aplicación de correo";
        ready.hidden = false;
        if (status) status.textContent = "Tu mensaje está preparado. Abre el mensaje para revisarlo en el canal y enviarlo cuando decidas.";
        ready.focus();
      });
    </script>
  </body>
</html>
