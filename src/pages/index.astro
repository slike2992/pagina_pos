ius:7px;background:var(--white);padding:30px}.plan-card.highlighted{border:2px solid var(--green);box-shadow:var(--shadow)}.plan-badge{position:absolute;top:0;right:22px;transform:translateY(-50%);border-radius:99px;background:var(--coral);color:var(--white);padding:6px 11px;font-size:.72rem;font-weight:900;text-transform:uppercase}.plan-name{margin-bottom:8px;color:var(--green);font-weight:900}.price{display:flex;align-items:baseline;gap:8px;margin-bottom:16px}.price strong{font-family:Georgia,"Times New Roman",serif;font-size:clamp(2.25rem,3.5vw,3.2rem);font-weight:500}.price span{color:var(--muted);font-size:.8rem}.plan-card>p:not(.plan-name){color:var(--muted)}.plan-card .check-list{margin-bottom:26px}.plan-button{margin-top:auto}.price-note{margin:22px auto 0;color:var(--muted);font-size:.83rem;text-align:center}.comparison-section{background:var(--white)}.comparison-scroll{overflow-x:auto;border:1px solid var(--line);border-radius:7px}.comparison-scroll:focus-visible{outline:3px solid rgba(185,86,54,.28);outline-offset:3px}table{width:100%;min-width:720px;border-collapse:collapse;background:var(--white)}th,td{padding:18px 20px;border-bottom:1px solid var(--line);text-align:left}thead{background:var(--green);color:var(--white)}tbody th{font-size:.9rem}.pro-cell{background:rgba(231,239,235,.65);font-weight:750}tbody tr:last-child th,tbody tr:last-child td{border-bottom:0}.cta-band{display:flex;align-items:center;justify-content:space-between;gap:36px;padding:clamp(58px,7vw,88px) clamp(20px,7vw,108px);background:var(--coral);color:var(--white)}.cta-band h2{max-width:800px;margin-bottom:10px}.cta-band p:last-child{margin:0;color:#ffe9e1}.cta-band .button{flex:none}.faq-section{background:var(--paper)}.faq-list{border-top:1px solid var(--line)}details{border-bottom:1px solid var(--line)}summary{display:flex;justify-content:space-between;gap:20px;padding:23px 4px;cursor:pointer;font-weight:800;list-style:none}summary::-webkit-details-marker{display:none}summary span