<style>
  .plan-group + .plan-group{margin-top:clamp(70px,9vw,118px)}
  .plan-group-heading{display:flex;align-items:end;justify-content:space-between;gap:36px;max-width:1200px;margin:0 auto 28px;border-bottom:1px solid var(--line);padding-bottom:18px}
  .plan-group-heading h3{margin:0;font-family:Georgia,"Times New Roman",serif;font-size:clamp(1.8rem,3vw,2.7rem);font-weight:500;line-height:1.05}
  .plan-group-heading>p{max-width:490px;margin:0;color:var(--muted)}
  .fe-eyebrow{color:#1c68b4}
  .plan-card{transition:transform .2s ease,border-color .2s ease,box-shadow .2s ease}
  .plan-card:hover,.plan-card:focus-within{border-color:var(--coral);box-shadow:0 18px 42px rgba(16,35,31,.16);transform:translateY(-5px)}
  .plan-card.highlighted:hover,.plan-card.highlighted:focus-within{border-color:var(--green);box-shadow:0 24px 52px rgba(16,35,31,.22)}
  .plan-card.fe-card:hover,.plan-card.fe-card:focus-within{border-color:#1c68b4}
  .plan-card.fe-card.highlighted{border-color:#1c68b4}
  .plan-card.fe-card.highlighted:hover,.plan-card.fe-card.highlighted:focus-within{border-color:#1c68b4}
  .fe-card .plan-name{color:#1c68b4}
  .annual-price{position:relative;display:grid;gap:2px;margin:0 0 20px;border-radius:6px;background:var(--mint);padding:12px 14px}
  .annual-price strong{font-family:Georgia,"Times New Roman",serif;font-size:1.65rem;font-weight:500}
  .annual-price span{color:var(--muted);font-size:.76rem}
  .annual-price em{position:absolute;top:-10px;right:10px;border-radius:99px;background:#16a467;color:#fff;padding:4px 9px;font-size:.7rem;font-style:normal;font-weight:850}
  .fe-card .annual-price{background:#e8f1fb}
  .plan-limits{display:grid;gap:8px;margin:0 0 10px;border-top:1px solid var(--line);padding-top:16px}
  .plan-limits div{display:flex;justify-content:space-between;gap:18px;font-size:.85rem}
  .plan-limits dt{color:var(--muted)}
