  @media(max-width:680px){.plan-group-heading{display:grid;gap:10px}.plan-group-heading>p{font-size:.94rem}.plan-card:hover,.plan-card:focus-within{transform:none}.annual-price strong{font-size:1.5rem}.plan-limits div{display:grid;gap:2px}.plan-limits dd{text-align:left}}
