---
import { Image } from "astro:assets";
import heroImage from "../assets/hero-comercio-pos.png";

const whatsappNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER?.replace(/\D/g, "") ?? "";
const whatsappUrl = (message: string) =>
  `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`;

const modules = [
  { number: "01", title: "Ventas ágiles", text: "Registra productos, cantidades y medios de pago desde un flujo pensado para atender sin fricción." },
  { number: "02", title: "Control de caja", text: "Organiza aperturas, cierres, movimientos y arqueos para entender cada turno con claridad." },
  { number: "03", title: "Inventario al día", text: "Consulta existencias y movimientos para anticipar faltantes y comprar con mejor información." },
  { number: "04", title: "Reportes útiles", text: "Revisa ventas, caja e inventario con indicadores claros para tomar decisiones oportunas." },
  { number: "05", title: "Usuarios y permisos", text: "Asigna responsabilidades y controla el acceso de cada persona según su función." },
  { number: "06", title: "Operación multisede", text: "Prepara el crecimiento de tu negocio con sucursales, cajas y control centralizado." },
];

const planCatalog = [
  {
    code: "basic",
    name: "Básico",
    summary: "Para empezar a vender con orden y controlar lo esencial del negocio.",
    monthly: "$49.900",
    annual: "$499.000",
    saving: "$100.000",
    users: "1 usuario",
    branches: "1 sucursal",
    registers: "1 caja",
    items: "Hasta 1.000 ítems",
    features: ["Ventas y caja", "Productos e inventario básico", "Reportes esenciales", "Soporte por chat", "Acompañamiento de arranque"],
    cta: "Elegir Básico",
    highlighted: false,
  },
  {
    code: "professional",
    name: "Profesional",
    summary: "Para negocios en crecimiento que necesitan más control operativo y mejores reportes.",
    monthly: "$79.900",
    annual: "$799.000",
    saving: "$100.000",
    users: "Hasta 3 usuarios",
    branches: "2 sucursales",
    registers: "2 cajas, una por sucursal",
    items: "Hasta 5.000 ítems",
    features: ["Todo lo del plan Básico", "Usuarios y permisos", "Inventario avanzado", "Compras y proveedores", "Reportes avanzados", "Soporte prioritario"],
    cta: "Elegir Profesional",
    highlighted: true,
  },
  {
    code: "enterprise",
    name: "Empresarial",
    summary: "Para operaciones con varias sedes y necesidades de gestión avanzada.",
    monthly: "$129.900",
    annual: "$1.299.000",
    saving: "$100.000",
    users: "Usuarios ilimitados",
    branches: "3 sucursales",
    registers: "Hasta 6 cajas, dos por sucursal",
    items: "Hasta 20.000 ítems",
    features: ["Todo lo del plan Profesional", "Permisos avanzados", "Indicadores gerenciales", "Preparado para integraciones", "Soporte prioritario y acompañamiento"],
    cta: "Elegir Empresarial",
    highlighted: false,
  },
] as const;

const electronicInvoicingPlans = [
  {
    ...planCatalog[0],
    code: "basic-fe",
    name: "Básico FE",
    summary: "Vende y factura electrónicamente desde el inicio, con una operación sencilla.",
    monthly: "$69.900",
    annual: "$699.000",
    saving: "$140.000",
    documents: "Hasta 1.000 documentos electrónicos al año",
    cta: "Elegir Básico FE",
  },
  {
    ...planCatalog[1],
    code: "professional-fe",
    name: "Profesional FE",
    summary: "Mayor control, mejores reportes y facturación electrónica para equipos en crecimiento.",
    monthly: "$99.900",
    annual: "$999.000",
    saving: "$200.000",
    documents: "Hasta 2.000 documentos electrónicos al año",
    cta: "Elegir Profesional FE",
  },
  {
    ...planCatalog[2],
    code: "enterprise-fe",
    name: "Empresarial FE",
    summary: "Control multisede y facturación electrónica para operaciones de alto volumen.",
    monthly: "$159.900",
    annual: "$1.599.000",
    saving: "$320.000",
    documents: "Documentos electrónicos ilimitados",
    cta: "Elegir Empresarial FE",
  },
] as const;

const plans = [...planCatalog, ...electronicInvoicingPlans];

const comparisons = [
  ["Usuarios", "1", "Hasta 3", "Ilimitados"],
  ["Sucursales", "1", "2", "3"],
  ["Cajas", "1", "2", "Hasta 6"],
  ["Ítems de inventario", "Hasta 1.000", "Hasta 5.000", "Hasta 20.000"],
  ["Inventario", "Esencial", "Avanzado", "Avanzado"],
  ["Reportes", "Esenciales", "Avanzados", "Gerenciales"],
];

const faqs = [
  ["¿Puedo conocer el sistema antes de contratar?", "Sí. Coordinamos una demostración enfocada en el flujo real de tu negocio para que puedas evaluar ventas, caja, inventario y reportes."],
  ["¿Necesito instalar el sistema en cada equipo?", "La plataforma está pensada para operar en la web. Durante la implementación revisamos tus equipos, conexión y necesidades para definir la configuración adecuada."],
  ["¿Qué incluye la implementación inicial?", "Incluye configuración, parametrización y acompañamiento de arranque. El valor de referencia es de $150.000 y se confirma según el alcance del negocio."],
  ["¿Puedo cambiar de plan más adelante?", "Sí. La estructura está preparada para acompañar el crecimiento del negocio y ajustar capacidades cuando la operación lo requiera."],
  ["¿Los precios publicados son definitivos?", "Son valores mensuales de referencia. La propuesta final confirma alcance, impuestos aplicables y condiciones de servicio antes de contratar."],
];

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Criptón",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  description: "Criptón: ventas, caja, inventario y reportes para comercios.",
  offers: plans.map((plan) => ({
    "@type": "Offer",
    name: `Plan ${plan.name}`,
    price: plan.monthly.replace(/[$.]/g, ""),
    priceCurrency: "COP",
  })),
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Controla ventas, caja, inventario y reportes con Criptón. Conoce los planes y solicita una demostración para tu negocio." />
    <meta name="theme-color" content="#123f38" />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:title" content="Criptón | Tu negocio bajo control" />
    <meta property="og:description" content="Ventas ágiles, caja organizada e inventario al día desde una sola plataforma." />
    <meta property="og:image" content="/images/og-sistema-pos.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <title>Criptón | Ventas, caja e inventario para tu negocio</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header" aria-label="Navegación principal">
      <a class="brand" href="#inicio" aria-label="Criptón, inicio">
        <span class="brand-mark" aria-hidden="true">C</span>
        <span>Criptón</span>
      </a>
      <nav class="desktop-nav" aria-label="Secciones">
        <a href="#solucion">Solución</a>
        <a href="#modulos">Módulos</a>
        <a href="#planes">Planes</a>
        <a href="#faq">Preguntas</a>
        <a href="/cuenta">Ingresar</a>
      </nav>
      <a class="header-cta" href="/registro?plan=professional">Crear cuenta</a>
      <details class="mobile-menu">
        <summary aria-label="Abrir menú"><span></span><span></span><span></span></summary>
        <nav aria-label="Secciones móviles">
          <a href="#solucion">Solución</a><a href="#modulos">Módulos</a><a href="#planes">Planes</a><a href="#faq">Preguntas</a><a href="/cuenta">Ingresar</a><a href="#contacto">Agendar demo</a>
        </nav>
      </details>
    </header>

    <main id="contenido">
      <section class="hero" id="inicio">
        <Image class="hero-image" src={heroImage} alt="Comerciante usando un terminal de punto de venta en su tienda" widths={[768, 1280, 1920]} sizes="100vw" format="webp" loading="eager" fetchpriority="high" />
        <div class="hero-shade" aria-hidden="true"></div>
        <div class="hero-content">
          <p class="eyebrow light">Control para comercios que quieren crecer</p>
          <h1>Criptón</h1>
          <p class="hero-lead">Vende con agilidad, mantén tu caja organizada y conoce tu inventario desde una sola plataforma.</p>
          <div class="hero-actions" aria-label="Acciones principales">
            <a class="button primary light-button" href="/registro?plan=professional">Empezar ahora</a>
            <a class="text-link light-link" href={whatsappUrl("Hola, quiero conocer Criptón para mi negocio.")} target="_blank" rel="noreferrer">Hablar por WhatsApp <span aria-hidden="true">→</span></a>
          </div>
          <p class="hero-note">Planes desde <strong>$49.900 al mes</strong> · Implementación acompañada</p>
        </div>
      </section>

      <section class="proof-strip" aria-label="Beneficios principales">
        <p><strong>Una sola operación</strong><span>Ventas, caja e inventario conectados</span></p>
        <p><strong>Decisiones con datos</strong><span>Reportes claros y oportunos</span></p>
        <p><strong>Acompañamiento real</strong><span>Configuración y puesta en marcha</span></p>
      </section>

      <section class="intro section" id="solucion">
        <div class="section-heading split-heading">
          <div><p class="eyebrow">Menos tareas sueltas</p><h2>Todo lo importante, en el mismo lugar</h2></div>
          <p>Diseñado para que el equipo trabaje con rapidez y tú puedas entender qué pasa en el negocio sin reunir información de varias fuentes.</p>
        </div>
        <div class="outcomes">
          <article><span>01</span><h3>Atiende mejor</h3><p>Un flujo de venta claro reduce pasos y mantiene la operación en movimiento.</p></article>
          <article><span>02</span><h3>Controla cada turno</h3><p>Caja, movimientos y arqueos quedan organizados para facilitar el seguimiento.</p></article>
          <article><span>03</span><h3>Compra con criterio</h3><p>Las existencias y reportes te ayudan a anticipar necesidades reales del inventario.</p></article>
        </div>
      </section>

      <section class="product-section section dark-section" aria-labelledby="product-title">
        <div class="product-copy">
          <p class="eyebrow light">Una vista para actuar</p>
          <h2 id="product-title">La jornada completa, sin perder el hilo</h2>
          <p>Consulta el ticket actual, las alertas de inventario y el avance de ventas desde una experiencia consistente.</p>
          <ul class="check-list"><li>Información útil en el momento de la venta</li><li>Alertas visibles para actuar a tiempo</li><li>Indicadores fáciles de leer</li></ul>
        </div>
        <div class="product-visual" aria-label="Vista ilustrativa del tablero de Criptón">
          <div class="screen-top"><span aria-hidden="true"></span><strong>Venta en mostrador</strong><em>Sesión activa</em></div>
          <div class="pos-grid">
            <section class="ticket-panel"><h3>Ticket actual</h3><div class="line-item"><span>Café premium</span><strong>$18.000</strong></div><div class="line-item"><span>Pan artesanal</span><strong>$7.500</strong></div><div class="line-item"><span>Bebida fría</span><strong>$6.900</strong></div><div class="total-row"><span>Total</span><strong>$32.400</strong></div><button type="button" tabindex="-1">Cobrar venta</button></section>
            <section class="stock-panel"><h3>Inventario</h3><div class="stock ok"><span>Arroz libra</span><strong>84</strong></div><div class="stock warn"><span>Azúcar</span><strong>9</strong></div><div class="stock ok"><span>Aceite</span><strong>31</strong></div></section>
            <section class="sales-panel"><p>Ventas de hoy</p><strong>$1.284.600</strong><div class="bars" aria-hidden="true"><span style="height:44%"></span><span style="height:72%"></span><span style="height:56%"></span><span style="height:86%"></span><span style="height:64%"></span></div></section>
          </div>
        </div>
      </section>

      <section class="modules-section section" id="modulos">
        <div class="section-heading"><p class="eyebrow">Capacidades</p><h2>Herramientas para la operación diaria</h2><p>Empieza por lo esencial y amplía el control a medida que tu negocio lo necesite.</p></div>
        <div class="module-list">{modules.map((module) => <article><span>{module.number}</span><div><h3>{module.title}</h3><p>{module.text}</p></div></article>)}</div>
      </section>

      <section class="steps-section section">
        <div class="section-heading"><p class="eyebrow">Puesta en marcha</p><h2>Del diagnóstico a la primera venta</h2></div>
        <ol class="steps"><li><span>1</span><div><h3>Conocemos tu operación</h3><p>Revisamos el tipo de negocio, los equipos y el flujo actual.</p></div></li><li><span>2</span><div><h3>Configuramos contigo</h3><p>Parametrizamos la solución y preparamos la información necesaria.</p></div></li><li><span>3</span><div><h3>Acompañamos el arranque</h3><p>Validamos el flujo y resolvemos dudas durante la puesta en marcha.</p></div></li></ol>
      </section>

      <section class="plans-section section" id="planes">
        <div class="section-heading centered"><p class="eyebrow">Planes</p><h2>Elige el nivel de control que necesitas</h2><p>Dos modalidades independientes para que contrates solo lo que tu operación necesita. Valores en pesos colombianos.</p></div>
        <div class="plan-group" aria-labelledby="plans-without-fe-title">
          <div class="plan-group-heading"><div><p class="eyebrow">Operación POS</p><h3 id="plans-without-fe-title">Planes sin facturación electrónica</h3></div><p>Ideales si ya tienes un proveedor de facturación o todavía no necesitas emitir documentos electrónicos.</p></div>
          <div class="plans-grid">{planCatalog.map((plan) => <article class:list={["plan-card", { highlighted: plan.highlighted }]}>{plan.highlighted && <span class="plan-badge">Más elegido</span>}<p class="plan-name">Plan {plan.name}</p><div class="price"><strong>{plan.monthly}</strong><span>COP / mes</span></div><div class="annual-price"><strong>{plan.annual}</strong><span>COP / año</span><em>Ahorra {plan.saving}</em></div><p>{plan.summary}</p><dl class="plan-limits"><div><dt>Usuarios</dt><dd>{plan.users}</dd></div><div><dt>Sucursales</dt><dd>{plan.branches}</dd></div><div><dt>Cajas</dt><dd>{plan.registers}</dd></div><div><dt>Inventario</dt><dd>{plan.items}</dd></div></dl><ul class="check-list">{plan.features.map((feature) => <li>{feature}</li>)}</ul><a class:list={["button plan-button", { primary: plan.highlighted }]} href={`/registro?plan=${plan.code}`}>{plan.cta}</a></article>)}</div>
        </div>
        <div class="plan-group plan-group-fe" aria-labelledby="plans-with-fe-title">
          <div class="plan-group-heading"><div><p class="eyebrow fe-eyebrow">Cumplimiento DIAN</p><h3 id="plans-with-fe-title">Planes con facturación electrónica</h3></div><p>POS y facturación electrónica en un solo lugar, con límites de documentos claros para cada nivel.</p></div>
          <div class="plans-grid">{electronicInvoicingPlans.map((plan) => <article class:list={["plan-card", "fe-card", { highlighted: plan.highlighted }]}>{plan.highlighted && <span class="plan-badge">Más elegido</span>}<p class="plan-name">Plan {plan.name}</p><div class="price"><strong>{plan.monthly}</strong><span>COP / mes</span></div><div class="annual-price"><strong>{plan.annual}</strong><span>COP / año</span><em>Ahorra {plan.saving}</em></div><p>{plan.summary}</p><dl class="plan-limits"><div><dt>Usuarios</dt><dd>{plan.users}</dd></div><div><dt>Sucursales</dt><dd>{plan.branches}</dd></div><div><dt>Cajas</dt><dd>{plan.registers}</dd></div><div><dt>Inventario</dt><dd>{plan.items}</dd></div></dl><ul class="check-list"><li>Facturación electrónica incluida</li><li>{plan.documents}</li>{plan.features.map((feature) => <li>{feature}</li>)}</ul><a class:list={["button plan-button", { primary: plan.highlighted }]} href={`/registro?plan=${plan.code}`}>{plan.cta}</a></article>)}</div>
        </div>
        <p class="price-note">Los límites de usuarios, cajas, sucursales, ítems y documentos se aplican por empresa y quedan asociados al plan contratado. La propuesta final confirma impuestos y condiciones del servicio.</p>
      </section>

      <section class="comparison-section section" id="comparador">
        <div class="section-heading"><p class="eyebrow">Comparación</p><h2>Encuentra el plan adecuado</h2></div>
        <div class="comparison-scroll" tabindex="0" aria-label="Comparador de planes; desplázate horizontalmente si es necesario">
          <table><caption class="sr-only">Comparación de capacidades por plan</caption><thead><tr><th scope="col">Capacidad</th><th scope="col">Básico</th><th scope="col">Profesional</th><th scope="col">Empresarial</th></tr></thead><tbody>{comparisons.map(([feature, basic, pro, enterprise]) => <tr><th scope="row">{feature}</th><td>{basic}</td><td class="pro-cell">{pro}</td><td>{enterprise}</td></tr>)}</tbody></table>
        </div>
      </section>

      <section class="cta-band">
        <div><p class="eyebrow light">Decide con tranquilidad</p><h2>Conoce el sistema aplicado a tu negocio</h2><p>Agenda una conversación y revisemos juntos el flujo que hoy quieres mejorar.</p></div>
        <a class="button light-button" href="#contacto">Quiero una demostración</a>
      </section>

      <section class="faq-section section" id="faq">
        <div class="section-heading"><p class="eyebrow">Preguntas frecuentes</p><h2>Lo que necesitas saber antes de empezar</h2></div>
        <div class="faq-list">{faqs.map(([question, answer]) => <details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div>
      </section>

      <section class="contact-section section" id="contacto">
        <div class="contact-copy"><p class="eyebrow light">Hablemos</p><h2>Cuéntanos cómo funciona tu negocio</h2><p>Completa los datos y prepararemos un mensaje de WhatsApp. No almacenamos esta información en la página.</p><dl><div><dt>Respuesta</dt><dd>Atención personalizada</dd></div><div><dt>Demostración</dt><dd>Enfocada en tu operación</dd></div><div><dt>Implementación</dt><dd>Acompañada de principio a fin</dd></div></dl></div>
        <form id="lead-form" data-whatsapp-number={whatsappNumber}>
          <label for="name">Nombre</label><input id="name" type="text" name="name" autocomplete="name" required placeholder="Tu nombre" />
          <label for="phone">Teléfono o WhatsApp</label><input id="phone" type="tel" name="phone" autocomplete="tel" required inputmode="tel" placeholder="300 000 0000" />
          <label for="plan">Plan de interés</label><select id="plan" name="plan"><option>Básico</option><option selected>Profesional</option><option>Empresarial</option></select>
          <label for="message">¿Qué te gustaría mejorar?</label><textarea id="message" name="message" rows="4" placeholder="Por ejemplo: controlar inventario y cierres de caja"></textarea>
          <button class="button primary" type="submit">Preparar mensaje en WhatsApp</button>
          <p class="form-note">Al continuar, WhatsApp abrirá el mensaje para que puedas revisarlo antes de enviarlo.</p>
          <p class="form-status" role="status" aria-live="polite"></p>
        </form>
      </section>
    </main>

    <footer><a class="brand" href="#inicio"><span class="brand-mark" aria-hidden="true">C</span><span>Criptón</span></a><p>Ventas, caja e inventario para comercios que quieren crecer con control.</p><a href="#contacto">Agendar demostración</a><span>© {new Date().getFullYear()} Criptón</span></footer>

    <script>
      const menu = document.querySelector<HTMLDetailsElement>(".mobile-menu");

      menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => menu.removeAttribute("open")));

      document.querySelector<HTMLFormElement>("#lead-form")?.addEventListener("submit", (event) => {
        event.preventDefault();
        const form = event.currentTarget as HTMLFormElement;
        const data = new FormData(form);
        const number = form.dataset.whatsappNumber ?? "";
        const message = [
          "Hola, quiero agendar una demostración de Criptón.",
          `Nombre: ${data.get("name")}`,
          `Teléfono: ${data.get("phone")}`,
          `Plan de interés: ${data.get("plan")}`,
          data.get("message") ? `Necesidad: ${data.get("message")}` : "",
        ].filter(Boolean).join("\n");
        const status = form.querySelector<HTMLElement>(".form-status");
        if (status) status.textContent = "Abriendo WhatsApp con tu mensaje listo…";
        window.open(`https://wa.me/${number}?text=${encodeURIComponent(message)}`, "_blank", "noopener,noreferrer");
      });
    </script>
  </body>
</html>

<style>
  :root{color-scheme:light;--ink:#17201e;--muted:#596763;--paper:#f7f8f5;--white:#fff;--line:#d8dfda;--green:#123f38;--green-2:#1c5d51;--mint:#e7efeb;--coral:#b95636;--gold:#d4a647;--shadow:0 22px 55px rgba(16,35,31,.14);font-family:Inter,"Aptos","Segoe UI",Arial,sans-serif}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:76px}body{margin:0;min-width:320px;background:var(--paper);color:var(--ink);line-height:1.55}body,button,input,select,textarea{font:inherit}a{color:inherit;text-decoration:none}button,a,summary{touch-action:manipulation}.skip-link{position:fixed;top:8px;left:8px;z-index:100;transform:translateY(-150%);background:var(--white);padding:10px 14px;border:2px solid var(--green)}.skip-link:focus{transform:none}.site-header{position:sticky;top:0;z-index:30;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;min-height:70px;padding:0 clamp(20px,4vw,64px);border-bottom:1px solid rgba(216,223,218,.8);background:rgba(247,248,245,.94);backdrop-filter:blur(16px)}.brand{display:inline-flex;align-items:center;gap:11px;width:max-content;font-weight:800}.brand-mark{display:grid;width:36px;height:36px;place-items:center;border-radius:6px;background:var(--green);color:var(--white);font-size:.76rem}.desktop-nav{display:flex;gap:clamp(18px,2.5vw,34px);color:var(--muted);font-size:.93rem}.desktop-nav a,.header-cta,footer a{transition:color .2s ease}.desktop-nav a:hover,.header-cta:hover,footer a:hover{color:var(--coral)}.header-cta{justify-self:end;color:var(--green);font-weight:800}.mobile-menu{display:none}.section{padding:clamp(72px,9vw,120px) clamp(20px,5vw,76px)}.section-heading{max-width:780px;margin-bottom:clamp(34px,5vw,58px)}.section-heading.centered{margin-inline:auto;text-align:center}.split-heading{display:grid;max-width:none;grid-template-columns:minmax(0,1fr) minmax(280px,.72fr);gap:clamp(36px,8vw,120px);align-items:end}.eyebrow{margin:0 0 12px;color:var(--coral);font-size:.76rem;font-weight:850;text-transform:uppercase}.eyebrow.light{color:#f2c078}h1,h2,h3,p{margin-top:0}h1{margin:0 0 22px;font-family:Georgia,"Times New Roman",serif;font-size:clamp(4rem,8vw,7.6rem);font-weight:500;line-height:.9;letter-spacing:0}h2{margin-bottom:16px;font-family:Georgia,"Times New Roman",serif;font-size:clamp(2.2rem,4.5vw,4.6rem);font-weight:500;line-height:1.02;letter-spacing:0}h3{margin-bottom:8px;font-size:1.12rem;letter-spacing:0}.section-heading>p:last-child,.split-heading>p,.product-copy>p,.contact-copy>p{color:var(--muted);font-size:clamp(1.02rem,1.5vw,1.2rem)}.hero{position:relative;display:flex;min-height:calc(88svh - 70px);align-items:center;overflow:hidden;background:#17201e;color:var(--white)}.hero-image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center}.hero-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(13,22,20,.94) 0%,rgba(13,22,20,.76) 36%,rgba(13,22,20,.12) 70%,rgba(13,22,20,.08) 100%)}.hero-content{position:relative;z-index:1;width:min(720px,90%);padding:clamp(76px,11vw,150px) clamp(20px,6vw,90px)}.hero-lead{max-width:640px;margin-bottom:30px;color:#e8eeeb;font-size:clamp(1.18rem,2vw,1.48rem)}.hero-actions{display:flex;align-items:center;gap:24px;margin-bottom:26px}.button{display:inline-flex;min-height:48px;align-items:center;justify-content:center;border:1px solid var(--green);border-radius:6px;background:transparent;padding:12px 19px;color:var(--green);font-weight:800;text-align:center;cursor:pointer;transition:transform .2s ease,background .2s ease,color .2s ease,box-shadow .2s ease}.button:hover{transform:translateY(-2px);box-shadow:0 10px 25px rgba(16,35,31,.12)}.button.primary{background:var(--green);color:var(--white)}.light-button{border-color:var(--white);background:var(--white);color:var(--green)}.text-link{font-weight:800}.light-link{color:var(--white)}.text-link span{display:inline-block;margin-left:7px;transition:transform .2s ease}.text-link:hover span{transform:translateX(4px)}.hero-note{margin:0;color