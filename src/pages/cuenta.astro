---
import FlowLayout from "../layouts/FlowLayout.astro";
const apiUrl = import.meta.env.PUBLIC_SAAS_API_URL ?? "http://localhost:4100";
const posUrl = import.meta.env.PUBLIC_POS_URL ?? "http://localhost:3002";
---
<FlowLayout title="Mi cuenta" eyebrow="Clientes" heading="Mi cuenta" lead="Consulta tu empresa, abre el POS y administra la renovación de tu plan.">
  <div class="account" id="account" data-api-url={apiUrl} data-pos-url={posUrl}>
    <form class="login-form" id="login-form">
      <div class="field full"><label for="email">Correo</label><input id="email" name="email" type="email" autocomplete="username" required /></div>
      <div class="field full"><label for="password">Contraseña</label><input id="password" name="password" type="password" autocomplete="current-password" maxlength="72" required /></div>
      <div class="field full" id="tenant-field" hidden><label for="tenant">Empresa</label><select id="tenant" name="tenantId"></select></div>
      <button class="button" type="submit">Ingresar</button>
      <a class="password-recovery-link" href="/recuperar-clave">¿Olvidaste tu contraseña?</a>
      <p class="status" role="status" aria-live="polite"></p>
    </form>

    <section class="account-panel" hidden>
      <div class="account-heading">
        <div><p class="label">Empresa</p><h2 data-field="tenant-name"></h2><p data-field="principal-name"></p></div>
        <span class="state" data-field="tenant-status"></span>
      </div>
      <dl class="subscription-data">
        <div><dt>Plan</dt><dd data-field="plan"></dd></div>
        <div><dt>Valor</dt><dd data-field="price"></dd></div>
        <div><dt>Estado</dt><dd data-field="subscription-status"></dd></div>
        <div><dt>Vencimiento actual</dt><dd data-field="period-end"></dd></div>
      </dl>
      <section class="plan-management" data-section="plan-management" hidden>
        <div>
          <label for="target-plan">Cambiar plan</label>
          <select id="target-plan">
            <option value="basic">Básico</option>
            <option value="professional">Profesional</option>
            <option value="enterprise">Empresarial</option>
          </select>
        </div>
        <button class="button secondary" data-action="change-plan" type="button">Revisar cambio</button>
      </section>
      <section class="recovery-management" data-section="recovery" hidden aria-labelledby="recovery-heading">
        <h3 id="recovery-heading">Recuperar períodos pendientes</h3>
        <p>La continuidad se cuenta desde el vencimiento anterior, no desde la fecha del nuevo pago. Cada checkout recupera un solo período.</p>
        <dl class="subscription-data" data-recovery-summary hidden>
          <div><dt>Importe de este período</dt><dd data-field="recovery-amount"></dd></div>
          <div><dt>Período exacto</dt><dd data-field="recovery-period"></dd></div>
        </dl>
        <p data-field="recovery-guidance"></p>
        <p class="status recovery-status" role="status" aria-live="polite"></p>
        <div class="actions">
          <button class="button" data-action="prepare-recovery" type="button" disabled>Preparar este pago</button>
          <a class="button" data-action="pay-recovery" hidden>Pagar este período en Wompi</a>
          <a class="button secondary" data-action="recovery-result" hidden>Consultar este pago</a>
          <button class="button secondary" data-action="refresh-recovery" type="button">Actualizar mi suscripción</button>
        </div>
      </section>
      <section class="payment-source-management" data-section="payment-source" hidden>
        <div>
          <p class="label">Renovación automática</p>
          <h3>Medio de pago</h3>
          <p>Wompi solicitará los datos de la tarjeta en su ventana segura.</p>
          <p class="current-source">Actual: <strong data-field="payment-source-current">Sin medio de pago registrado</strong></p>
        </div>
        <div class="acceptances">
          <label><input type="checkbox" data-acceptance="terms" /> Acepto el <a data-field="wompi-terms" target="_blank" rel="noopener noreferrer">reglamento de usuarios de Wompi</a>.</label>
          <label><input type="checkbox" data-acceptance="personal-data" /> Autorizo el <a data-field="wompi-personal-data" target="_blank" rel="noopener noreferrer">tratamiento de datos personales</a>.</label>
          <label><input type="checkbox" data-acceptance="recurring" /> <span data-field="recurring-consent">Autorizo el uso de esta tarjeta para renovar automáticamente mi plan.</span></label>
        </div>
        <button class="button secondary" data-action="add-payment-source" type="button" disabled>Agregar tarjeta</button>
        <p class="status payment-source-status" role="status" aria-live="polite"></p>
      </section>
      <p class="status account-status" role="status" aria-live="polite"></p>
      <div class="actions">
        <a class="button" data-action="open-pos" href={posUrl}>Abrir POS</a>
        <button class="button secondary" data-action="cancel" type="button">Cancelar renovación</button>
        <button class="button secondary" data-action="reactivate" type="button" hidden>Reactivar renovación</button>
        <button class="text-button" data-action="logout" type="button">Cerrar sesión</button>
      </div>
    </section>

    <dialog id="cancel-dialog">
      <form method="dialog">
        <h2>Cancelar renovación</h2>
        <p>Tu acceso continuará hasta <strong data-field="cancel-date"></strong>. Después, la empresa quedará suspendida sin borrar su información.</p>
        <div class="actions">
          <button class="button secondary" value="close">Conservar plan</button>
          <button class="button danger" id="confirm-cancel" value="confirm">Confirmar cancelación</button>
        </div>
      </form>
    </dialog>

    <dialog id="plan-dialog">
      <form method="dialog">
        <h2>Cambiar a <span data-field="target-plan-name"></span></h2>
        <p data-field="plan-change-copy"></p>
        <div class="actions">
          <button class="button secondary" value="close">Volver</button>
          <button class="button" id="confirm-plan-change" value="confirm">Confirmar cambio</button>
        </div>
      </form>
    </dialog>
  </div>

  <script>
    import { createIdempotencyKey } from "../scripts/client-idempotency";
    import { prepareWompiSession } from "../lib/wompi-client";
    import { readRecoveryOffer, readRecoveryCheckout, recoveryAmount, recoveryPeriodText, rememberRecoveryCheckout, type RecoveryOffer, type RecoveryCheckout } from "../lib/subscription-recovery";

    type Tenant = { tenantId: string; tenantKey: string; name: string; status: string; role: string };
    type LoginResult = { accessToken: string; expiresAt: string; principal: { displayName: string }; tenant: Tenant };
    type Subscription = { subscriptionId: string; status: string; plan: { code: string; name: string }; price: { amountMinor: number; currency: string; billingInterval: string }; currentPeriodEnd: string | null; cancelAtPeriodEnd: boolean };
    type PlanChange = { subscriptionChangeId: string; changeType: "upgrade" | "downgrade"; status: string; toPlan: { name: string }; quote: { amountMinor: number; currency: string }; effectiveAt: string; nextAction: "checkout" | "wait_for_period_end" };
    type PaymentSourceConfig = { publicKey: string; widgetScriptUrl: string; fraudScriptUrl: string; acceptance: { token: string; permalink: string }; personalDataAuthorization: { token: string; permalink: string } };
    type PaymentSource = { type: "card" | "nequi"; displayHint: string | null; recurringConsentAt: string };
    type TokenizedSource = { token: string; type: "CARD" | "NEQUI" };
    type WidgetCheckoutInstance = { open(callback: (result: { payment_source?: TokenizedSource }) => void): void };
    type WidgetCheckoutConstructor = new (config: { publicKey: string; widgetOperation: "tokenize"; bootstrapTransport: "postmessage" }) => WidgetCheckoutInstance;

    const root = document.querySelector<HTMLElement>("#account")!;
    const loginForm = root.querySelector<HTMLFormElement>("#login-form")!;
    const loginStatus = loginForm.querySelector<HTMLElement>(".status")!;
    const tenantField = root.querySelector<HTMLElement>("#tenant-field")!;
    const tenantSelect = root.querySelector<HTMLSelectElement>("#tenant")!;
    const panel = root.querySelector<HTMLElement>(".account-panel")!;
    const accountStatus = panel.querySelector<HTMLElement>(".account-status")!;
    const posLink = panel.querySelector<HTMLAnchorElement>("[data-action='open-pos']")!;
    const cancelButton = panel.querySelector<HTMLButtonElement>("[data-action='cancel']")!;
    const reactivateButton = panel.querySelector<HTMLButtonElement>("[data-action='reactivate']")!;
    const dialog = root.querySelector<HTMLDialogElement>("#cancel-dialog")!;
    const confirmCancel = root.querySelector<HTMLButtonElement>("#confirm-cancel")!;
    const planSection = root.querySelector<HTMLElement>("[data-section='plan-management']")!;
    const planSelect = root.querySelector<HTMLSelectElement>("#target-plan")!;
    const changePlanButton = root.querySelector<HTMLButtonElement>("[data-action='change-plan']")!;
    const planDialog = root.querySelector<HTMLDialogElement>("#plan-dialog")!;
    const confirmPlanChange = root.querySelector<HTMLButtonElement>("#confirm-plan-change")!;
    const paymentSourceSection = root.querySelector<HTMLElement>("[data-section='payment-source']")!;
    const paymentSourceButton = root.querySelector<HTMLButtonElement>("[data-action='add-payment-source']")!;
    const paymentSourceStatus = root.querySelector<HTMLElement>(".payment-source-status")!;
    const termsAcceptance = root.querySelector<HTMLInputElement>("[data-acceptance='terms']")!;
    const personalDataAcceptance = root.querySelector<HTMLInputElement>("[data-acceptance='personal-data']")!;
    const recurringAcceptance = root.querySelector<HTMLInputElement>("[data-acceptance='recurring']")!;
    const recoverySection = root.querySelector<HTMLElement>("[data-section='recovery']")!;
    const recoverySummary = root.querySelector<HTMLElement>("[data-recovery-summary]")!;
    const recoveryStatus = root.querySelector<HTMLElement>(".recovery-status")!;
    const recoveryPrepare = root.querySelector<HTMLButtonElement>("[data-action='prepare-recovery']")!;
    const recoveryPay = root.querySelector<HTMLAnchorElement>("[data-action='pay-recovery']")!;
    const recoveryResult = root.querySelector<HTMLAnchorElement>("[data-action='recovery-result']")!;
    const recoveryRefresh = root.querySelector<HTMLButtonElement>("[data-action='refresh-recovery']")!;
    const apiUrl = root.dataset.apiUrl?.replace(/\/$/, "") ?? "";
    const posUrl = root.dataset.posUrl?.replace(/\/$/, "") ?? "";
    let accessToken = "";
    let currentSubscription: Subscription | null = null;
    let pendingChange: PlanChange | null = null;
    let changeIdempotencyKey = "";
    let checkoutIdempotencyKey = "";
    let paymentSourceConfig: PaymentSourceConfig | null = null;
    let paymentSourceBusy = false;
    let paymentSourceAttempt = "";
    let accountLogin: LoginResult | null = null;
    let recoveryOffer: RecoveryOffer | null = null;
    let recoveryCheckout: RecoveryCheckout | null = null;
    let recoveryKey = "";
    let recoverySnapshot = "";
    let recoveryBusy = false;
    let recoveryGeneration = 0;

    const field = (name: string) => root.querySelector<HTMLElement>(`[data-field='${name}']`)!;
    const messageFrom = (body: unknown, fallback: string) => typeof body === "object" && body && "error" in body
      ? (body as { error?: { message?: string } }).error?.message ?? fallback
      : fallback;
    const formatDate = (value: string | null) => value
      ? new Intl.DateTimeFormat("es-CO", { dateStyle: "long" }).format(new Date(value))
      : "Por confirmar";
    const statusLabels: Record<string, string> = {
      active: "Activo", past_due: "Pago pendiente", grace: "En gracia", restricted: "Solo lectura",
      suspended: "Suspendido", cancel_at_period_end: "Cancelación programada", pending: "Pendiente"
    };

    const renderAccount = (login: LoginResult, subscription: Subscription) => {
      currentSubscription = subscription;
      field("tenant-name").textContent = login.tenant.name;
      field("principal-name").textContent = `${login.principal.displayName} · ${login.tenant.role}`;
      field("tenant-status").textContent = statusLabels[login.tenant.status] ?? login.tenant.status;
      field("plan").textContent = subscription.plan.name;
      field("price").textContent = `${new Intl.NumberFormat("es-CO", { style: "currency", currency: subscription.price.currency, maximumFractionDigits: 0 }).format(subscription.price.amountMinor / 100)} / ${subscription.price.billingInterval === "annual" ? "año" : "mes"}`;
      field("subscription-status").textContent = statusLabels[subscription.status] ?? subscription.status;
      field("period-end").textContent = formatDate(subscription.currentPeriodEnd);
      field("recurring-consent").textContent = `Autorizo la renovación automática de ${subscription.plan.name} por ${new Intl.NumberFormat("es-CO", { style: "currency", currency: subscription.price.currency, maximumFractionDigits: 0 }).format(subscription.price.amountMinor / 100)} ${subscription.price.currency} ${subscription.price.billingInterval === "annual" ? "al año" : "al mes"}, desde mi próximo periodo. Puedo cancelar la renovación desde Mi cuenta.`;
      field("cancel-date").textContent = formatDate(subscription.currentPeriodEnd);
      const scheduled = subscription.cancelAtPeriodEnd || subscription.status === "cancel_at_period_end";
      const canManage = ["owner", "admin", "billing"].includes(login.tenant.role);
      cancelButton.hidden = scheduled || !canManage;
      reactivateButton.hidden = !scheduled || !canManage;
      planSection.hidden = scheduled || !canManage || subscription.status !== "active";
      paymentSourceSection.hidden = scheduled || !canManage || !["active", "past_due", "grace", "restricted", "suspended"].includes(subscription.status);
      recoverySection.hidden = !canManage || !["active", "past_due", "grace", "restricted", "suspended"].includes(subscription.status)
        || (subscription.status === "active" && (!subscription.currentPeriodEnd || Date.parse(subscription.currentPeriodEnd) > Date.now()));
      planSelect.value = subscription.plan.code;
      accountStatus.textContent = scheduled ? `La renovación está cancelada desde el ${formatDate(subscription.currentPeriodEnd)}.` : "";
      accountStatus.dataset.state = scheduled ? "success" : "";
      posLink.href = posUrl;
      loginForm.hidden = true;
      panel.hidden = false;
    };

    const clearRecoveryLinks = () => {
      recoveryCheckout = null;
      recoveryPay.hidden = true;
      recoveryPay.removeAttribute("href");
      recoveryResult.hidden = true;
      recoveryResult.removeAttribute("href");
    };
    const loadRecoveryOffer = async (refreshSubscription = false) => {
      if (recoveryBusy || !accessToken || !currentSubscription || !accountLogin) return;
      const token = accessToken;
      const generation = ++recoveryGeneration;
      const isCurrent = () => token === accessToken && generation === recoveryGeneration;
      recoveryBusy = true;
      recoveryPrepare.disabled = true;
      recoveryRefresh.disabled = true;
      recoveryOffer = null;
      clearRecoveryLinks();
      recoverySummary.hidden = true;
      field("recovery-guidance").textContent = "";
      recoveryStatus.textContent = "Consultando el período pendiente…";
      recoveryStatus.dataset.state = "";
      try {
        if (refreshSubscription) {
          const response = await fetch(`${apiUrl}/v1/me/subscription`, { headers: { authorization: `Bearer ${token}` } });
          const body = await response.json();
          if (!isCurrent()) return;
          if (!response.ok) throw body;
          renderAccount(accountLogin!, body as Subscription);
        }
        if (recoverySection.hidden) return;
        const response = await fetch(`${apiUrl}/v1/me/subscription/recovery`, { headers: { authorization: `Bearer ${token}` } });
        const body = await response.json();
        if (!isCurrent()) return;
        if (!response.ok) throw body;
        const offer = readRecoveryOffer(body, currentSubscription!.subscriptionId);
        recoveryOffer = offer;
        if (offer.status === "blocked") {
          const reasons: Record<string, string> = {
            not_due: "La suscripción no tiene un período vencido que recuperar.",
            cancellation: "La renovación está cancelada. Este flujo no revoca la cancelación.",
            payment_pending: "Hay un pago pendiente de confirmación. Consúltalo antes de iniciar otro período.",
            requires_review: "Este cobro requiere revisión. Contacta a soporte antes de volver a pagar.",
            plan_change_pending: "Hay un cambio de plan pendiente. Resuélvelo antes de recuperar otro período."
          };
          recoveryStatus.textContent = reasons[offer.blockReason ?? ""] ?? "No hay un período disponible para recuperar.";
          if (typeof offer.checkoutSessionId === "string" && /^[0-9a-f-]{36}$/i.test(offer.checkoutSessionId)) {
            recoveryResult.href = `/pago/resultado?checkoutSessionId=${encodeURIComponent(offer.checkoutSessionId)}`;
            recoveryResult.hidden = false;
          }
          return;
        }
        const snapshot = `${offer.subscriptionId.toLowerCase()}:${offer.periodStart}`;
        if (snapshot !== recoverySnapshot) { recoveryKey = ""; recoverySnapshot = snapshot; }
        field("recovery-amount").textContent = recoveryAmount(offer.amountMinor, offer.currency);
        field("recovery-period").textContent = recoveryPeriodText(offer);
        field("recovery-guidance").textContent = offer.needsFurtherRecovery
          ? "Este período todavía termina en el pasado. Al aplicarse el pago, la suscripción seguirá vencida. Podrás revisar y pagar los períodos siguientes uno a uno."
          : "El retorno de Wompi no habilita acceso. Espera la aplicación del período y revisa el estado confirmado en Mi cuenta.";
        recoverySummary.hidden = false;
        recoveryPrepare.disabled = false;
        recoveryPrepare.textContent = offer.status === "pending_payment" ? "Continuar con este período pendiente" : "Preparar este pago";
        recoveryStatus.textContent = "Revisa el importe y las fechas antes de preparar el checkout.";
      } catch (error) {
        if (!isCurrent()) return;
        recoveryStatus.textContent = messageFrom(error, error instanceof Error ? error.message : "No pudimos consultar la recuperación. Actualiza Mi cuenta.");
        recoveryStatus.dataset.state = "error";
      } finally {
        if (isCurrent()) { recoveryBusy = false; recoveryRefresh.disabled = false; }
      }
    };
    recoveryPrepare.addEventListener("click", async () => {
      if (recoveryBusy || recoveryCheckout || !accessToken || recoverySection.hidden || !recoveryOffer || recoveryOffer.status === "blocked") return;
      const token = accessToken;
      const generation = recoveryGeneration;
      const offer = recoveryOffer;
      const isCurrent = () => token === accessToken && generation === recoveryGeneration;
      if (!recoveryKey) recoveryKey = createIdempotencyKey();
      const key = recoveryKey;
      recoveryBusy = true;
      recoveryPrepare.disabled = true;
      recoveryRefresh.disabled = true;
      recoveryStatus.textContent = "Preparando el checkout de este período…";
      recoveryStatus.dataset.state = "";
      try {
        const input = { type: "recovery", subscriptionId: offer.subscriptionId, expectedPeriodStart: offer.periodStart };
        const response = await fetch(`${apiUrl}/v1/me/billing/checkout-sessions`, {
          method: "POST", headers: { authorization: `Bearer ${token}`, "content-type": "application/json", "idempotency-key": key },
          body: JSON.stringify(input)
        });
        const body = await response.json();
        if (!isCurrent()) return;
        if (!response.ok) throw body;
        const checkout = readRecoveryCheckout(body, input, location.origin);
        if (checkout.amountInCents !== offer.amountMinor || checkout.currency !== offer.currency || checkout.recovery.periodEnd !== offer.periodEnd) {
          throw new Error("La oferta cambió. Actualiza Mi cuenta y revisa el importe y período antes de pagar.");
        }
        if (Date.parse(checkout.expirationTime) <= Date.now()) throw new Error("El checkout venció. Actualiza Mi cuenta antes de continuar.");
        recoveryCheckout = checkout;
        rememberRecoveryCheckout(checkout.checkoutSessionId, () => sessionStorage);
        recoveryPay.href = checkout.checkoutUrl;
        recoveryPay.hidden = false;
        recoveryResult.href = `/pago/resultado?checkoutSessionId=${encodeURIComponent(checkout.checkoutSessionId)}`;
        recoveryResult.hidden = false;
        recoveryStatus.textContent = `Checkout preparado. Referencia ${checkout.reference}. El pago se confirmará en el servidor.`;
      } catch (error) {
        if (!isCurrent()) return;
        clearRecoveryLinks();
        recoveryStatus.textContent = messageFrom(error, error instanceof Error ? error.message : "No pudimos preparar el checkout. Puedes reintentar el mismo período o actualizar Mi cuenta.");
        recoveryStatus.dataset.state = "error";
        recoveryPrepare.disabled = false;
      } finally {
        if (isCurrent()) { recoveryBusy = false; recoveryRefresh.disabled = false; }
      }
    });
    recoveryPay.addEventListener("click", event => {
      if (!accessToken || !recoveryCheckout || Date.parse(recoveryCheckout.expirationTime) <= Date.now()) {
        event.preventDefault();
        clearRecoveryLinks();
        recoveryStatus.textContent = "Actualiza Mi cuenta antes de continuar con este pago.";
        recoveryStatus.dataset.state = "error";
      }
    });
    recoveryRefresh.addEventListener("click", () => { void loadRecoveryOffer(true); });

    const safeContractUrl = (value: string) => {
      const url = new URL(value);
      if (url.protocol !== "https:") throw new Error("Wompi devolvió un contrato inseguro.");
      return url.href;
    };
    const preparePaymentSource = async () => {
      const preparingAccessToken = accessToken;
      paymentSourceButton.disabled = true;
      termsAcceptance.disabled = true;
      personalDataAcceptance.disabled = true;
      recurringAcceptance.disabled = true;
      paymentSourceConfig = null;
      paymentSourceStatus.textContent = "Preparando el registro seguro…";
      paymentSourceStatus.dataset.state = "";
      try {
        const currentResponse = await fetch(`${apiUrl}/v1/me/billing/payment-sources`, {
          headers: { authorization: `Bearer ${preparingAccessToken}` }
        });
        const currentBody = await currentResponse.json();
        if (accessToken !== preparingAccessToken) return;
        if (!currentResponse.ok) throw currentBody;
        const current = currentBody.paymentSource as PaymentSource | null;
        field("payment-source-current").textContent = current?.displayHint
          ?? (current ? "Medio de pago registrado" : "Sin medio de pago registrado");
        paymentSourceButton.textContent = current ? "Cambiar tarjeta" : "Agregar tarjeta";

        const response = await fetch(`${apiUrl}/v1/public/payment-source-config`);
        const body = await response.json();
        if (!response.ok) throw body;
        const config = body as PaymentSourceConfig;
        if (accessToken !== preparingAccessToken) return;
        field("wompi-terms").setAttribute("href", safeContractUrl(config.acceptance.permalink));
        field("wompi-personal-data").setAttribute("href", safeContractUrl(config.personalDataAuthorization.permalink));
        paymentSourceConfig = config;
        termsAcceptance.disabled = false;
        personalDataAcceptance.disabled = false;
        recurringAcceptance.disabled = false;
        paymentSourceStatus.textContent = "";
        paymentSourceButton.disabled = false;
      } catch (error) {
        if (accessToken !== preparingAccessToken) return;
        paymentSourceStatus.textContent = messageFrom(error, error instanceof Error ? error.message : "No fue posible preparar el registro seguro.");
        paymentSourceStatus.dataset.state = "error";
        paymentSourceButton.textContent = "Reintentar registro seguro";
        paymentSourceButton.disabled = false;
      }
    };

    loginForm.addEventListener("submit", async (event) => {
      event.preventDefault();
      const button = loginForm.querySelector<HTMLButtonElement>("button[type='submit']")!;
      button.disabled = true;
      loginStatus.textContent = "Validando acceso…";
      loginStatus.dataset.state = "";
      try {
        const data = new FormData(loginForm);
        const payload: Record<string, string> = { email: String(data.get("email") ?? ""), password: String(data.get("password") ?? "") };
        const tenantId = String(data.get("tenantId") ?? "");
        if (!tenantField.hidden && tenantId) payload.tenantId = tenantId;
        const response = await fetch(`${apiUrl}/v1/auth/login`, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(payload) });
        const body = await response.json();
        if (response.status === 409 && body.error?.code === "tenant_selection_required" && Array.isArray(body.tenants)) {
          tenantSelect.replaceChildren(...body.tenants.map((tenant: Tenant) => new Option(tenant.name, tenant.tenantId)));
          tenantField.hidden = false;
          loginStatus.textContent = "Selecciona la empresa y vuelve a ingresar.";
          return;
        }
        if (!response.ok) throw body;
        const login = body as LoginResult;
        accountLogin = login;
        accessToken = login.accessToken;
        const subscriptionResponse = await fetch(`${apiUrl}/v1/me/subscription`, { headers: { authorization: `Bearer ${accessToken}` } });
        const subscription = await subscriptionResponse.json();
        if (!subscriptionResponse.ok) throw subscription;
        renderAccount(login, subscription as Subscription);
        if (!paymentSourceSection.hidden) void preparePaymentSource();
        if (!recoverySection.hidden) void loadRecoveryOffer();
        loginForm.reset();
      } catch (error) {
        accessToken = "";
        loginStatus.textContent = messageFrom(error, "No fue posible iniciar sesión.");
        loginStatus.dataset.state = "error";
      } finally {
        button.disabled = false;
      }
    });

    const planNames: Record<string, string> = { basic: "Básico", professional: "Profesional", enterprise: "Empresarial" };
    paymentSourceButton.addEventListener("click", async () => {
      if (paymentSourceBusy || !accessToken) return;
      if (!paymentSourceConfig) { await preparePaymentSource(); return; }
      if (!termsAcceptance.checked || !personalDataAcceptance.checked || !recurringAcceptance.checked) {
        paymentSourceStatus.textContent = "Acepta los documentos de Wompi y autoriza la renovación automática para continuar.";
        paymentSourceStatus.dataset.state = "error";
        return;
      }
      const registrationAccessToken = accessToken;
      const config = paymentSourceConfig;
      const attempt = createIdempotencyKey();
      paymentSourceAttempt = attempt;
      paymentSourceBusy = true;
      paymentSourceButton.disabled = true;
      paymentSourceStatus.textContent = "Preparando la ventana segura de Wompi…";
      paymentSourceStatus.dataset.state = "";
      try {
      const sessionId = await prepareWompiSession(config);
      if (accessToken !== registrationAccessToken || paymentSourceAttempt !== attempt) return;
      const WidgetCheckout = (window as typeof window & { WidgetCheckout?: WidgetCheckoutConstructor }).WidgetCheckout;
      if (!WidgetCheckout) throw new Error("La ventana segura de Wompi no quedó disponible. Vuelve a intentarlo.");
      const checkout = new WidgetCheckout({
        publicKey: config.publicKey,
        widgetOperation: "tokenize",
        bootstrapTransport: "postmessage"
      });
      let submitted = false;
      checkout.open(async (result) => {
        if (submitted || paymentSourceAttempt !== attempt || accessToken !== registrationAccessToken) return;
        const source = result?.payment_source;
        if (!source || typeof source.token !== "string" || !["CARD", "NEQUI"].includes(source.type)) {
          paymentSourceStatus.textContent = "Wompi no devolvió un medio de pago válido.";
          paymentSourceStatus.dataset.state = "error";
          paymentSourceButton.disabled = false;
          return;
        }
        submitted = true;
        paymentSourceBusy = true;
        paymentSourceButton.disabled = true;
        paymentSourceStatus.textContent = "Registrando el medio de pago…";
        try {
          const response = await fetch(`${apiUrl}/v1/me/billing/payment-sources`, {
            method: "POST",
            headers: {
              authorization: `Bearer ${registrationAccessToken}`,
              "content-type": "application/json",
              "idempotency-key": attempt
            },
            body: JSON.stringify({
              type: source.type,
              recurringConsent: true,
              paymentMethodToken: source.token,
              sessionId,
              acceptanceToken: config.acceptance.token,
              personalDataAuthToken: config.personalDataAuthorization.token
            })
          });
          const body = await response.json();
          if (accessToken !== registrationAccessToken || paymentSourceAttempt !== attempt) return;
          if (!response.ok) throw body;
          paymentSourceStatus.textContent = body.displayHint
            ? `${body.displayHint} quedó disponible para la renovación.`
            : "El medio de pago quedó disponible para la renovación.";
          field("payment-source-current").textContent = body.displayHint ?? "Medio de pago registrado";
          paymentSourceButton.textContent = "Cambiar tarjeta";
          paymentSourceStatus.dataset.state = "success";
          termsAcceptance.checked = false;
          personalDataAcceptance.checked = false;
          recurringAcceptance.checked = false;
          paymentSourceButton.disabled = false;
        } catch (error) {
          if (accessToken !== registrationAccessToken || paymentSourceAttempt !== attempt) return;
          paymentSourceStatus.textContent = messageFrom(error, "No fue posible confirmar el medio de pago.");
          paymentSourceStatus.dataset.state = "error";
          const code = typeof error === "object" && error && "error" in error
            ? (error as { error?: { code?: string } }).error?.code
            : undefined;
          paymentSourceButton.disabled = code !== "payment_source_provider_rejected";
        } finally {
          if (paymentSourceAttempt === attempt) paymentSourceBusy = false;
        }
      });
      // The provider closes its overlay without a cancellation callback.
      // A later opening supersedes this attempt; only one callback can submit.
      if (!submitted) {
        paymentSourceBusy = false;
        paymentSourceButton.disabled = false;
        paymentSourceStatus.textContent = "Completa el registro en Wompi. Si cierras la ventana, puedes volver a abrirla.";
      }
      } catch (error) {
        if (accessToken !== registrationAccessToken || paymentSourceAttempt !== attempt) return;
        paymentSourceStatus.textContent = error instanceof Error ? error.message : "No fue posible abrir Wompi. Vuelve a intentarlo.";
        paymentSourceStatus.dataset.state = "error";
        paymentSourceBusy = false;
        paymentSourceButton.disabled = false;
      }
    });
    const continueToUpgradeCheckout = async (change: PlanChange) => {
      if (!checkoutIdempotencyKey) checkoutIdempotencyKey = createIdempotencyKey();
      const response = await fetch(`${apiUrl}/v1/me/billing/checkout-sessions`, {
        method: "POST",
        headers: {
          authorization: `Bearer ${accessToken}`,
          "content-type": "application/json",
          "idempotency-key": checkoutIdempotencyKey
        },
        body: JSON.stringify({ subscriptionChangeId: change.subscriptionChangeId })
      });
      const body = await response.json();
      if (!response.ok) throw body;
      sessionStorage.setItem("checkout-session-id", body.checkoutSessionId);
      location.assign(body.checkoutUrl);
    };

    changePlanButton.addEventListener("click", async () => {
      if (pendingChange?.nextAction === "checkout") {
        changePlanButton.disabled = true;
        accountStatus.textContent = "Preparando el pago seguro…";
        try {
          await continueToUpgradeCheckout(pendingChange);
        } catch (error) {
          accountStatus.textContent = messageFrom(error, "No fue posible abrir el pago seguro.");
          accountStatus.dataset.state = "error";
          changePlanButton.disabled = false;
        }
        return;
      }
      if (!currentSubscription || planSelect.value === currentSubscription.plan.code) {
        accountStatus.textContent = "Selecciona un plan diferente al actual.";
        accountStatus.dataset.state = "error";
        return;
      }
      field("target-plan-name").textContent = planNames[planSelect.value] ?? planSelect.value;
      field("plan-change-copy").textContent = `El servidor confirmará si corresponde un cobro proporcional o un cambio al finalizar el periodo actual (${formatDate(currentSubscription.currentPeriodEnd)}). Tus datos no se eliminarán.`;
      planDialog.showModal();
    });

    confirmPlanChange.addEventListener("click", async (event) => {
      event.preventDefault();
      confirmPlanChange.disabled = true;
      if (!changeIdempotencyKey) changeIdempotencyKey = createIdempotencyKey();
      try {
        const response = await fetch(`${apiUrl}/v1/me/subscription/change`, {
          method: "POST",
          headers: {
            authorization: `Bearer ${accessToken}`,
            "content-type": "application/json",
            "idempotency-key": changeIdempotencyKey
          },
          body: JSON.stringify({ targetPlanCode: planSelect.value })
        });
        const body = await response.json();
        if (!response.ok) throw body;
        pendingChange = body as PlanChange;
        planDialog.close();
        if (pendingChange.nextAction === "wait_for_period_end") {
          planSection.hidden = true;
          accountStatus.textContent = `Cambio a ${pendingChange.toPlan.name} programado para el ${formatDate(pendingChange.effectiveAt)}. Tus datos se conservarán.`;
          accountStatus.dataset.state = "success";
          return;
        }
        const amount = new Intl.NumberFormat("es-CO", { style: "currency", currency: pendingChange.quote.currency, maximumFractionDigits: 0 }).format(pendingChange.quote.amountMinor / 100);
        accountStatus.textContent = `Prorrateo confirmado: ${amount}. Preparando el pago seguro…`;
        accountStatus.dataset.state = "success";
        try {
          await continueToUpgradeCheckout(pendingChange);
        } catch (error) {
          accountStatus.textContent = `${messageFrom(error, "No fue posible abrir el pago seguro.")} La cotización sigue disponible en esta sesión.`;
          accountStatus.dataset.state = "error";
          changePlanButton.textContent = "Continuar al pago";
        }
      } catch (error) {
        accountStatus.textContent = messageFrom(error, "No fue posible solicitar el cambio de plan.");
        accountStatus.dataset.state = "error";
        planDialog.close();
      } finally {
        confirmPlanChange.disabled = false;
      }
    });

    cancelButton.addEventListener("click", () => dialog.showModal());
    confirmCancel.addEventListener("click", async (event) => {
      event.preventDefault();
      confirmCancel.disabled = true;
      try {
        const response = await fetch(`${apiUrl}/v1/me/subscription/cancel`, { method: "POST", headers: { authorization: `Bearer ${accessToken}` } });
        const body = await response.json();
        if (!response.ok) throw body;
        currentSubscription = body as Subscription;
        field("subscription-status").textContent = statusLabels[currentSubscription.status] ?? currentSubscription.status;
        cancelButton.hidden = true;
        reactivateButton.hidden = false;
        planSection.hidden = true;
        accountStatus.textContent = `La renovación quedó cancelada desde el ${formatDate(currentSubscription.currentPeriodEnd)}.`;
        accountStatus.dataset.state = "success";
        dialog.close();
      } catch (error) {
        accountStatus.textContent = messageFrom(error, "No fue posible cancelar la renovación.");
        accountStatus.dataset.state = "error";
        dialog.close();
      } finally {
        confirmCancel.disabled = false;
      }
    });
    reactivateButton.addEventListener("click", async () => {
      reactivateButton.disabled = true;
      accountStatus.textContent = "Reactivando la renovación…";
      accountStatus.dataset.state = "";
      try {
        const response = await fetch(`${apiUrl}/v1/me/subscription/reactivate`, { method: "POST", headers: { authorization: `Bearer ${accessToken}` } });
        const body = await response.json();
        if (!response.ok) throw body;
        currentSubscription = body as Subscription;
        field("subscription-status").textContent = statusLabels[currentSubscription.status] ?? currentSubscription.status;
        reactivateButton.hidden = true;
        cancelButton.hidden = false;
        planSection.hidden = currentSubscription.status !== "active";
        accountStatus.textContent = "La renovación está activa nuevamente.";
        accountStatus.dataset.state = "success";
      } catch (error) {
        accountStatus.textContent = messageFrom(error, "No fue posible reactivar la renovación.");
        accountStatus.dataset.state = "error";
      } finally {
        reactivateButton.disabled = false;
      }
    });
    posLink.addEventListener("click", async (event) => {
      event.preventDefault();
      if (!accessToken || posLink.getAttribute("aria-disabled") === "true") return;
      posLink.setAttribute("aria-disabled", "true");
      accountStatus.textContent = "Abriendo el POS…";
      accountStatus.dataset.state = "";
      try {
        const response = await fetch(`${apiUrl}/v1/auth/pos-sso`, {
          method: "POST",
          headers: { authorization: `Bearer ${accessToken}` }
        });
        const body = await response.json();
        if (!response.ok) throw body;
        const destination = new URL(String(body.redirectUrl ?? ""));
        const expected = new URL(posUrl);
        if (destination.origin !== expected.origin || destination.pathname !== "/auth/sso") {
          throw new Error("Destino POS inválido");
        }
        window.location.assign(destination.toString());
      } catch (error) {
        accountStatus.textContent = messageFrom(error, "No fue posible abrir el POS.");
        accountStatus.dataset.state = "error";
        posLink.removeAttribute("aria-disabled");
      }
    });
    panel.querySelector<HTMLButtonElement>("[data-action='logout']")!.addEventListener("click", () => {
      accessToken = "";
      accountLogin = null;
      recoveryGeneration++;
      recoveryBusy = false;
      recoveryOffer = null;
      recoveryKey = "";
      recoverySnapshot = "";
      recoverySummary.hidden = true;
      recoverySection.hidden = true;
      recoveryStatus.textContent = "";
      recoveryStatus.dataset.state = "";
      clearRecoveryLinks();
      posLink.removeAttribute("aria-disabled");
      currentSubscription = null;
      pendingChange = null;
      changeIdempotencyKey = "";
      checkoutIdempotencyKey = "";
      paymentSourceConfig = null;
      paymentSourceBusy = false;
      paymentSourceAttempt = "";
      termsAcceptance.checked = false;
      personalDataAcceptance.checked = false;
      recurringAcceptance.checked = false;
      paymentSourceStatus.textContent = "";
      paymentSourceStatus.dataset.state = "";
      paymentSourceButton.disabled = true;
      field("payment-source-current").textContent = "Sin medio de pago registrado";
      paymentSourceButton.textContent = "Agregar tarjeta";
      changePlanButton.disabled = false;
      changePlanButton.textContent = "Revisar cambio";
      accountStatus.textContent = "";
      accountStatus.dataset.state = "";
      panel.hidden = true;
      tenantField.hidden = true;
      loginStatus.textContent = "";
      loginForm.hidden = false;
      loginForm.querySelector<HTMLInputElement>("#email")!.focus();
    });
  </script>
</FlowLayout>

<style>
  .account{width:min(680px,100%)}
  .login-form{display:grid;gap:12px}
  .password-recovery-link{justify-self:start;color:var(--green);font-size:.9rem;font-weight:750;text-decoration-thickness:1px;text-underline-offset:3px}
  .account-panel{display:grid;gap:22px}
  .recovery-management{display:grid;gap:12px;border-top:1px solid var(--line);padding-top:18px}.recovery-management h3,.recovery-management p{margin:0}.recovery-management p{line-height:1.5}.recovery-management .actions{flex-wrap:wrap}
  .account-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;border-bottom:1px solid var(--line);padding-bottom:18px}
  .account-heading h2{margin:0;font-family:Georgia,"Times New Roman",serif;font-size:2rem;font-weight:500;letter-spacing:0}
  .account-heading p{margin:4px 0 0;color:var(--muted)}
  .label{font-size:.78rem;font-weight:850;text-transform:uppercase}
  .state{flex:none;border:1px solid var(--line);border-radius:5px;padding:7px 10px;color:var(--green);font-size:.78rem;font-weight:850}
  .subscription-data{display:grid;grid-template-columns:1fr 1fr;gap:0;margin:0}
  .subscription-data div{border-bottom:1px solid var(--line);padding:14px 10px 14px 0}
  .subscription-data dt{color:var(--muted);font-size:.78rem}
  .subscription-data dd{margin:3px 0 0;font-weight:800;overflow-wrap:anywhere}
  .plan-management{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:end;gap:14px;border-top:1px solid var(--line);padding-top:18px}
  .plan-management>div{display:grid;gap:6px}.plan-management label{font-size:.78rem;font-weight:850}
  .payment-source-management{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:end;gap:14px;border-top:1px solid var(--line);padding-top:18px}
  .payment-source-management h3{margin:2px 0 4px;font-size:1.05rem;letter-spacing:0}.payment-source-management p{margin:0;color:var(--muted)}
  .payment-source-management .current-source{margin-top:8px;color:var(--ink)}
  .acceptances{grid-column:1/-1;display:grid;gap:9px}.acceptances label{display:flex;align-items:flex-start;gap:9px;color:var(--muted);font-size:.9rem;line-height:1.45}.acceptances input{flex:none;margin-top:3px}.acceptances a{color:var(--green);font-weight:750}
  .payment-source-status{grid-column:1/-1}
  .text-button{border:0;background:transparent;color:var(--green);padding:12px;font-weight:800;cursor:pointer}
  dialog{width:min(520px,calc(100% - 32px));border:1px solid var(--line);border-radius:7px;padding:0;color:var(--ink)}
  dialog::backdrop{background:rgba(11,45,40,.55)}
  dialog form{display:grid;gap:18px;padding:26px}
  dialog h2{margin:0;font-family:Georgia,"Times New Roman",serif;font-size:2rem;font-weight:500;letter-spacing:0}
  dialog p{margin:0;color:var(--muted)}
  .button.danger{border-color:#963d2a;background:#963d2a}
  @media(max-width:560px){.account-heading{align-items:flex-start;flex-direction:column}.subscription-data{grid-template-columns:1fr}.plan-management,.payment-source-management{grid-template-columns:1fr}.actions{display:grid}.actions>*{width:100%}}
</style>
