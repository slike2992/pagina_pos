---
import FlowLayout from "../../layouts/FlowLayout.astro";
const apiUrl = import.meta.env.PUBLIC_SAAS_API_URL ?? "http://localhost:4100";
---
<FlowLayout title="Estado del pago" eyebrow="Pago" heading="Confirmación segura" lead="El servidor confirma el pago y su aplicación. Volver de Wompi no habilita acceso por sí solo.">
  <div class="result" id="payment-result" data-api-url={apiUrl}>
    <h2 id="result-heading">Estamos consultando tu pago</h2>
    <p class="status" role="status" aria-live="polite">Verificando la confirmación del proveedor…</p>
    <dl hidden>
      <div><dt>Referencia</dt><dd data-field="reference"></dd></div>
      <div><dt>Valor</dt><dd data-field="amount"></dd></div>
    </dl>
    <p data-detail>No dependemos del resultado mostrado por el navegador.</p>
    <div class="actions">
      <a class="button" id="password-link" href="#" hidden>Crear contraseña</a>
      <button class="button" id="retry-payment" type="button" hidden>Consultar de nuevo</button>
      <a class="button secondary" href="/">Volver al inicio</a>
    </div>
  </div>
  <script>
    import { readRecoveryStatus, recoveryDate, recoveryPeriodText, recoveryAmount, isKnownRecoveryCheckout, type RecoveryStatus } from "../../lib/subscription-recovery";
    const root = document.querySelector<HTMLElement>("#payment-result")!;
    const heading = root.querySelector<HTMLElement>("#result-heading")!;
    const status = root.querySelector<HTMLElement>(".status")!;
    const detail = root.querySelector<HTMLElement>("[data-detail]")!;
    const summary = root.querySelector<HTMLDListElement>("dl")!;
    const reference = root.querySelector<HTMLElement>("[data-field='reference']")!;
    const amount = root.querySelector<HTMLElement>("[data-field='amount']")!;
    const retry = root.querySelector<HTMLButtonElement>("#retry-payment")!;
    const passwordLink = root.querySelector<HTMLAnchorElement>("#password-link")!;
    const apiUrl = root.dataset.apiUrl?.replace(/\/$/, "") ?? "";
    let storedCheckoutId: string | null = null;
    try { storedCheckoutId = sessionStorage.getItem("checkout-session-id"); } catch { /* The URL also identifies a checkout in a new tab. */ }
    const checkoutSessionId = new URLSearchParams(location.search).get("checkoutSessionId") ?? storedCheckoutId;
    let recoveryExpected = checkoutSessionId ? isKnownRecoveryCheckout(checkoutSessionId, () => sessionStorage) : false;
    const terminalStates = new Set(["fulfilled", "declined", "expired", "cancelled", "refunded"]);
    let attempts = 0;
    let timer: number | undefined;
    let inFlight = false;
    let stopped = false;

    const render = (result: { status: string; reference: string; amountInCents: number; currency: string; recovery?: RecoveryStatus }) => {
      const recovery = result.recovery === undefined ? null : readRecoveryStatus(result.recovery);
      status.dataset.state = "";
      reference.textContent = result.reference;
      amount.textContent = new Intl.NumberFormat("es-CO", { style: "currency", currency: result.currency, maximumFractionDigits: 0 }).format(result.amountInCents / 100);
      summary.hidden = false;
      retry.hidden = result.status !== "declined";
      if (recovery) {
        amount.textContent = recoveryAmount(result.amountInCents, result.currency);
        const period = recoveryPeriodText(recovery);
        if (result.status === "fulfilled") {
          const overdue = recovery.needsFurtherRecovery || Date.parse(recovery.coveredThrough) <= Date.now();
          heading.textContent = overdue ? "Período recuperado; quedan períodos pendientes" : "Período recuperado";
          status.textContent = `El servidor aplicó este período. Cobertura hasta ${recoveryDate(recovery.coveredThrough)} (UTC).`;
          status.dataset.state = "success";
          detail.textContent = `${period} ${overdue
            ? "La suscripción todavía está vencida. Este pago no la puso al día ni habilita acceso. Revisa el siguiente período en Mi cuenta; los pagos se realizan uno a uno."
            : recovery.subscriptionStatus === "active" && recovery.tenantStatus === "active"
              ? "Revisa tu suscripción y acceso en Mi cuenta."
              : "El período fue aplicado, pero el acceso todavía requiere revisión. Consulta el estado en Mi cuenta."}`;
          passwordLink.href = "/cuenta";
          passwordLink.textContent = overdue ? "Revisar siguiente período en Mi cuenta" : "Revisar Mi cuenta";
          passwordLink.hidden = false;
        } else if (result.status === "approved" || result.status === "pending") {
          heading.textContent = result.status === "approved" ? "Pago confirmado; aplicando el período" : "Estamos confirmando este pago";
          status.textContent = "Espera a que el servidor termine de aplicar el período. El retorno no confirma acceso.";
          detail.textContent = `${period} Si este período todavía termina en el pasado, seguirán pendientes períodos siguientes.`;
        } else {
          const labels: Record<string, string> = { declined: "Pago rechazado", expired: "Orden vencida", cancelled: "Pago cancelado", refunded: "Pago reembolsado" };
          heading.textContent = labels[result.status] ?? "No fue posible confirmar el pago";
          status.textContent = "Este resultado no confirma la recuperación del período.";
          status.dataset.state = "error";
          detail.textContent = `${period} Consulta el estado en Mi cuenta antes de preparar otro pago.`;
        }
        return;
      }
      if (result.status === "approved" || result.status === "fulfilled") {
        heading.textContent = result.status === "fulfilled" ? "Tu empresa está lista" : "Pago confirmado";
        status.textContent = result.status === "fulfilled" ? "El aprovisionamiento terminó correctamente." : "Estamos preparando tu empresa.";
        status.dataset.state = "success";
        detail.textContent = "Estamos preparando el acceso para crear tu contraseña.";
      } else if (result.status === "pending") {
        heading.textContent = "Estamos confirmando";
        status.textContent = "Wompi todavía no ha confirmado el pago al sistema.";
        detail.textContent = "Puedes esperar en esta página. La consulta se actualizará automáticamente.";
      } else {
        const labels: Record<string, string> = { declined: "Pago rechazado", expired: "Orden vencida", cancelled: "Pago cancelado", refunded: "Pago reembolsado" };
        heading.textContent = labels[result.status] ?? "No fue posible confirmar el pago";
        status.textContent = "Tu empresa no fue activada.";
        status.dataset.state = "error";
        detail.textContent = result.status === "declined" ? "Puedes volver al checkout e intentar con otro medio de pago." : "Contacta a soporte indicando la referencia mostrada.";
        retry.hidden = result.status !== "declined";
      }
    };

    const loadDevelopmentPasswordSetup = async () => {
      if (!checkoutSessionId) return;
      const response = await fetch(`${apiUrl}/v1/development/checkout-sessions/${encodeURIComponent(checkoutSessionId)}/password-setup`);
      if (!response.ok) return;
      const body = await response.json();
      if (body.status === "ready" && typeof body.passwordSetupUrl === "string") {
        passwordLink.href = body.passwordSetupUrl;
        passwordLink.hidden = false;
        detail.textContent = "La empresa quedó aprovisionada. Crea la contraseña de prueba para entrar al POS.";
      } else if (body.status === "completed") {
        passwordLink.href = "/cuenta";
        passwordLink.textContent = "Ingresar a Mi cuenta";
        passwordLink.hidden = false;
        detail.textContent = "Tu empresa está lista. Ingresa con el correo y la contraseña que ya utilizas.";
      }
    };

    const queryStatus = async () => {
      if (inFlight || stopped) return;
      if (timer !== undefined) window.clearTimeout(timer);
      timer = undefined;
      if (!checkoutSessionId) {
        heading.textContent = "No encontramos la orden";
        status.textContent = "Abre esta página desde el flujo de pago iniciado en este navegador.";
        status.dataset.state = "error";
        detail.textContent = "Si ya pagaste, revisa tu correo o contacta a soporte.";
        return;
      }
      inFlight = true;
      attempts += 1;
      retry.disabled = true;
      retry.hidden = true;
      passwordLink.hidden = true;
      let retryable = true; // A rejected fetch has no HTTP response.
      let pollAgain = false;
      try {
        const response = await fetch(`${apiUrl}/v1/checkout-sessions/${encodeURIComponent(checkoutSessionId)}`, { headers: { accept: "application/json" } });
        retryable = response.status === 429 || (response.status >= 500 && response.status < 600);
        if (!response.ok) throw await response.json().catch(() => null);
        const body = await response.json();
        if (body.recovery !== undefined) recoveryExpected = true;
        if (recoveryExpected && body.recovery === undefined) throw new Error("Faltan los datos de recuperación. Consulta Mi cuenta.");
        render(body);
        if (body.status === "fulfilled" && body.recovery === undefined) {
          if (import.meta.env.DEV) await loadDevelopmentPasswordSetup();
          else {
            passwordLink.href = "/cuenta";
            passwordLink.textContent = "Ingresar a Mi cuenta";
            passwordLink.hidden = false;
            detail.textContent = "Tu empresa está lista. Si es tu primera cuenta, recibirás por correo el enlace para crear tu contraseña. Si ya tienes una, puedes ingresar con ella.";
          }
        }
        pollAgain = !terminalStates.has(body.status);
      } catch (error) {
        const message = typeof error === "object" && error && "error" in error ? (error as { error?: { message?: string } }).error?.message : null;
        const willRetry = retryable && attempts < 10;
        heading.textContent = willRetry ? "Estamos consultando tu pago" : "No pudimos consultar el pago";
        status.textContent = willRetry ? "La conexión no está disponible temporalmente. Reintentando…" : message ?? "No pudimos consultar el pago en este momento.";
        status.dataset.state = willRetry ? "" : "error";
        detail.textContent = retryable ? "Volveremos a consultar automáticamente en unos segundos." : "Puedes consultar de nuevo o contactar a soporte.";
        retry.hidden = false;
        pollAgain = retryable;
      } finally {
        inFlight = false;
        retry.disabled = false;
        if (pollAgain && !stopped) {
          if (attempts < 10) {
            retry.hidden = true;
            timer = window.setTimeout(() => { timer = undefined; void queryStatus(); }, 3000);
          } else {
            retry.hidden = false;
            detail.textContent = "La consulta automática terminó. Puedes consultar de nuevo.";
          }
        }
      }
    };

    retry.addEventListener("click", () => { if (inFlight || stopped) return; attempts = 0; status.dataset.state = ""; void queryStatus(); });
    window.addEventListener("pagehide", () => { stopped = true; if (timer !== undefined) window.clearTimeout(timer); }, { once: true });
    void queryStatus();
  </script>
</FlowLayout>
