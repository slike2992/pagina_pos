---
import type { ContractSection } from '../lib/customer-contract';
interface Props { sections: readonly ContractSection[]; slaHref?: string; }
const { sections, slaHref } = Astro.props;
---
{sections.map(section => <section aria-labelledby={section.id}>
  <h2 id={section.id}>{section.heading}</h2>
  {section.paragraphs?.map(paragraph => <p>{paragraph}</p>)}
  {section.items?.length && <ul>{section.items.map(item => <li>{item}</li>)}</ul>}
  {section.subsections?.map(part => <div>
    <h3>{part.heading}</h3>
    {part.paragraphs?.map(paragraph => <p>{paragraph}</p>)}
    {part.items?.length && <ul>{part.items.map(item => <li>{item}</li>)}</ul>}
  </div>)}
  {slaHref && ['soporte-y-salida', 'soporte-y-continuidad'].includes(section.id) &&
    <nav aria-label="Acuerdo de nivel de servicio"><a href={slaHref}>Consultar el SLA/ANS de esta versión</a></nav>}
</section>)}
