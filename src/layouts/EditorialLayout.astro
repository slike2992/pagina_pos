---
import "../styles/base.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SeoHead from "../components/SeoHead.astro";
import { publicPageUrl, SITE_URL } from "../lib/seo";
interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  lead: string;
  breadcrumbs?: { name: string; href: string }[];
  noindex?: boolean;
}
const { title, description, eyebrow, heading, lead, breadcrumbs = [], noindex = false } = Astro.props;
const normalizedPath = (value: string) => value.replace(/\/+$/, "") || "/";
const currentPath = normalizedPath(Astro.url.pathname);
const seen = new Set(["/"]);
const crumbs = [{ name: "Inicio", href: "/" }, ...breadcrumbs.filter(crumb => {
  const value = normalizedPath(crumb.href);
  if (seen.has(value) || value === currentPath) return false;
  seen.add(value); return true;
})];
const commercialPage = Astro.url.pathname.startsWith("/soluciones/") || Astro.url.pathname.startsWith("/guias/");
const canonical = !noindex && publicPageUrl(Astro.url.pathname);
const schema = canonical ? {
  "@context": "https://schema.org", "@type": "BreadcrumbList",
  itemListElement: [...crumbs, { name: heading, href: Astro.url.pathname }].map((crumb, i) => ({
    "@type": "ListItem", position: i + 1, name: crumb.name, item: new URL(crumb.href, SITE_URL).href,
  })),
} : null;
---
<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#051828" />
    <SeoHead title={title.includes("Cripton") ? title : `${title} | Cripton`} description={description} noindex={noindex} />
    <link rel="icon" type="image/svg+xml" href="/brand/v1.0/favicon.svg" />
    <link rel="icon" href="/brand/v1.0/favicon.ico" sizes="any" />
    <link rel="manifest" href="/site.webmanifest" />
    {schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, "\\u003c")} />}
  </head>
  <body>
    <SiteHeader />
    <main id="contenido" tabindex="-1">
      <section class="editorial-hero">
        <nav aria-label="Ruta de navegación"><ol>{crumbs.map(crumb => <li><a href={crumb.href}>{crumb.name}</a></li>)}<li aria-current="page">{heading}</li></ol></nav>
        <p class="eyebrow">{eyebrow}</p>
        <h1>{heading}</h1>
        <p class="lead">{lead}</p>
        {commercialPage && <div class="editorial-actions"><a class="button" href="/#contacto" data-track="demo" data-track-location="content">Solicitar una demostración</a><a href="/#planes" data-track="plans" data-track-location="content">Comparar planes</a></div>}
      </section>
      <div class="editorial-copy"><slot /></div>
    </main>
    <SiteFooter />
  </body>
</html>
<style>
  .editorial-hero { padding: 26px clamp(20px, 7vw, 104px) clamp(40px, 6vw, 72px); background: var(--ink); color: white; }
  .editorial-hero > * { max-width: 1040px; margin-inline: auto; }
  nav { margin-bottom: 40px; }
  nav ol { display: flex; gap: 8px 14px; flex-wrap: wrap; padding: 0; list-style: none; color: #b9d1dc; font-size: .82rem; }
  nav li + li::before { content: "/"; padding-right: 14px; color: #6d98aa; }
  nav a { color: inherit; }
  nav a:focus-visible { outline-color: var(--gold); }
  .eyebrow { color: var(--gold); }
  h1 { margin-bottom: 22px; font-size: clamp(2.25rem, 4.8vw, 4rem); line-height: 1.08; }
  .editorial-actions { display:flex; align-items:center; flex-wrap:wrap; gap:20px; margin-top:28px; }
  .editorial-actions .button { background:var(--gold); border-color:var(--gold); color:var(--ink); }
  .editorial-actions>a:not(.button) { color:white; font-weight:700; }
  .lead { margin-bottom: 0; color: #d6e8f0; font-size: clamp(1.08rem, 1.8vw, 1.3rem); max-width: 1040px; }
</style>
