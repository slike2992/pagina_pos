---
import Brand from "../components/Brand.astro";

interface Props {
  title: string;
  eyebrow: string;
  heading: string;
  lead: string;
}

const { title, eyebrow, heading, lead } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={lead} />
    <meta name="robots" content="noindex, follow" />
    <meta name="theme-color" content="#002552" />
    <link rel="icon" type="image/svg+xml" href="/brand/v1.0/favicon.svg" />
    <link rel="icon" href="/brand/v1.0/favicon.ico" sizes="any" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{title} | Cripton</title>
  </head>
  <body>
    <header>
      <Brand className="flow-brand" kind="nombre" />
      <a href="/">Volver al inicio</a>
    </header>
    <main>
      <section class="intro">
        <img class="intro-brand" src="/brand/v1.0/cripton_vertical_reverso_v1.0.svg" alt="Cripton" width="1082" height="1048" />
        <p class="eyebrow">{eyebrow}</p>
        <h1>{heading}</h1>
        <p class="lead">{lead}</p>
      </section>
      <section class="surface"><slot /></section>
    </main>
    <footer><Brand className="footer-brand" kind="nombre" tone="reverse" /> <span>© {new Date().getFullYear()} Cripton</span></footer>
  </body>
</html>

<style is:global>
  [hidden]{display:none!important}
  :root{--ink:#002552;--muted:#526675;--paper:#f4f7fa;--white:#fff;--line:#d3dde6;--green:#002552;--green-2:#006b80;--coral:#a33d28;--gold:#00def8;font-family:Inter,"Aptos","Segoe UI",Arial,sans-serif;color:var(--ink);background:var(--paper)}
  *{box-sizing:border-box}body{margin:0;min-width:320px;line-height:1.5}a{color:var(--green);font-weight:750}
  header{display:flex;min-height:68px;align-items:center;justify-content:space-between;padding:0 clamp(18px,5vw,72px);border-bottom:1px solid var(--line);background:var(--white)}
  .flow-brand{--brand-name-width:160px}
  main{display:grid;grid-template-columns:minmax(360px,.85fr) minmax(0,1.15fr);min-height:calc(100svh - 132px)}
  .intro{padding:clamp(48px,5.5vw,88px) clamp(24px,6vw,88px);background:var(--green);color:var(--white)}
  .intro-brand{width:min(220px,100%);height:auto;margin:0 0 24px}.eyebrow{margin:0 0 14px;color:var(--gold);font-size:.78rem;font-weight:850;text-transform:uppercase}
  .intro h1{max-width:650px;margin:0 0 18px;font-size:clamp(2.7rem,4.4vw,4.6rem);font-weight:700;line-height:1;letter-spacing:0}.lead{max-width:590px;color:#d7e8f1;font-size:1.12rem}
  .surface{display:flex;min-width:0;align-items:center;justify-content:center;padding:clamp(40px,5vw,88px);background:var(--paper)}
  .flow-form,.result{display:grid;width:min(620px,100%);gap:12px}.flow-form{grid-template-columns:1fr 1fr}.field{display:grid;gap:6px}.field.full,.actions,.status,.legal-check{grid-column:1/-1}.field label,.legal-check{font-size:.86rem;font-weight:750}.field input,.field select{width:100%;min-height:48px;border:1px solid #b9c8d5;border-radius:5px;background:var(--white);padding:10px 12px;color:var(--ink)}.legal-check{display:flex;align-items:flex-start;gap:10px;margin:7px 0}.legal-check input{width:18px;height:18px;flex:none;margin-top:2px}.button{display:inline-flex;min-height:48px;align-items:center;justify-content:center;border:1px solid var(--green);border-radius:6px;background:var(--green);padding:12px 18px;color:var(--white);font-weight:800;text-decoration:none;cursor:pointer}.button.secondary{background:var(--white);color:var(--green)}.button:disabled{cursor:not-allowed;opacity:.55}.actions{display:flex;gap:10px;flex-wrap:wrap}.status{min-height:24px;margin:0;color:var(--muted);font-size:.9rem}.status[data-state="error"]{color:var(--coral)}.status[data-state="success"]{color:var(--green);font-weight:750}.result h2{margin:0;font-size:2.2rem;font-weight:700;letter-spacing:0}.result dl{display:grid;gap:10px;margin:10px 0}.result dl div{border-top:1px solid var(--line);padding-top:10px}.result dt{color:var(--muted);font-size:.8rem}.result dd{margin:2px 0 0;font-weight:750;overflow-wrap:anywhere}.legal-copy{width:min(760px,100%)}.legal-copy h2{margin-top:30px;font-size:1.2rem}.legal-copy p,.legal-copy li{color:#374b5a}.legal-copy li+li{margin-top:8px}
  footer{display:flex;min-height:64px;align-items:center;gap:18px;padding:15px clamp(18px,5vw,72px);background:#002552;color:#bfd7e5;font-size:.82rem}.footer-brand{--brand-name-width:136px}
  @media(max-width:1100px){main{grid-template-columns:1fr;min-height:0}.intro{padding:52px 24px}.surface{padding:42px 20px}}@media(max-width:560px){header{padding-inline:16px}.flow-brand{--brand-name-width:136px}header>a:last-child{font-size:.82rem}.flow-form{grid-template-columns:1fr}.field{grid-column:1/-1}.actions{display:grid}.actions .button{width:100%}.intro-brand{width:220px}footer{align-items:flex-start;flex-direction:column;gap:8px}}
</style>
