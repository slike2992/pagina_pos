---
interface Props {
  title: string;
  eyebrow: string;
  heading: string;
  lead: string;
}

const { title, eyebrow, heading, lead } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={lead} />
    <meta name="robots" content="noindex, follow" />
    <title>{title} | Sistema POS</title>
  </head>
  <body>
    <header>
      <a class="brand" href="/"><span aria-hidden="true">SP</span><strong>Sistema POS</strong></a>
      <a href="/">Volver al inicio</a>
    </header>
    <main>
      <section class="intro">
        <p class="eyebrow">{eyebrow}</p>
        <h1>{heading}</h1>
        <p class="lead">{lead}</p>
      </section>
      <section class="surface"><slot /></section>
    </main>
    <footer>© {new Date().getFullYear()} Sistema POS</footer>
  </body>
</html>

<style is:global>
  [hidden]{display:none!important}
  :root{--ink:#17201e;--muted:#596763;--paper:#f7f8f5;--white:#fff;--line:#d8dfda;--green:#123f38;--green-2:#1c5d51;--coral:#b95636;--gold:#d4a647;font-family:Inter,"Aptos","Segoe UI",Arial,sans-serif;color:var(--ink);background:var(--paper)}*{box-sizing:border-box}body{margin:0;min-width:320px;line-height:1.5}a{color:var(--green);font-weight:750}header{display:flex;min-height:68px;align-items:center;justify-content:space-between;padding:0 clamp(18px,5vw,72px);border-bottom:1px solid var(--line);background:var(--white)}.brand{display:flex;align-items:center;gap:10px;text-decoration:none}.brand span{display:grid;width:36px;height:36px;place-items:center;border-radius:6px;background:var(--green);color:var(--white);font-size:.75rem}.brand strong{color:var(--ink)}main{display:grid;grid-template-columns:minmax(280px,.75fr) minmax(420px,1fr);min-height:calc(100vh - 118px)}.intro{padding:clamp(58px,9vw,120px) clamp(20px,7vw,96px);background:var(--green);color:var(--white)}.eyebrow{margin:0 0 14px;color:#f2c078;font-size:.78rem;font-weight:850;text-transform:uppercase}.intro h1{max-width:650px;margin:0 0 22px;font-family:Georgia,"Times New Roman",serif;font-size:clamp(2.7rem,6vw,5.6rem);font-weight:500;line-height:1;letter-spacing:0}.lead{max-width:590px;color:#d7e3df;font-size:1.12rem}.surface{display:flex;align-items:center;padding:clamp(34px,7vw,90px)}.flow-form,.result{display:grid;width:min(620px,100%);gap:12px}.flow-form{grid-template-columns:1fr 1fr}.field{display:grid;gap:6px}.field.full,.actions,.status,.legal-check{grid-column:1/-1}.field label,.legal-check{font-size:.86rem;font-weight:750}.field input,.field select{width:100%;min-height:48px;border:1px solid #bcc8c1;border-radius:5px;background:var(--white);padding:10px 12px;color:var(--ink)}.legal-check{display:flex;align-items:flex-start;gap:10px;margin:7px 0}.legal-check input{width:18px;height:18px;flex:none;margin-top:2px}.button{display:inline-flex;min-height:48px;align-items:center;justify-content:center;border:1px solid var(--green);border-radius:6px;background:var(--green);padding:12px 18px;color:var(--white);font-weight:800;text-decoration:none;cursor:pointer}.button.secondary{background:var(--white);color:var(--green)}.button:disabled{cursor:not-allowed;opacity:.55}.actions{display:flex;gap:10px;flex-wrap:wrap}.status{min-height:24px;margin:0;color:var(--muted);font-size:.9rem}.status[data-state="error"]{color:#a33d28}.status[data-state="success"]{color:var(--green);font-weight:750}.result h2{margin:0;font-family:Georgia,"Times New Roman",serif;font-size:2.2rem;font-weight:500;letter-spacing:0}.result dl{display:grid;gap:10px;margin:10px 0}.result dl div{border-top:1px solid var(--line);padding-top:10px}.result dt{color:var(--muted);font-size:.8rem}.result dd{margin:2px 0 0;font-weight:750;overflow-wrap:anywhere}.legal-copy{width:min(760px,100%)}.legal-copy h2{margin-top:30px;font-size:1.2rem}.legal-copy p,.legal-copy li{color:#37433f}.legal-copy li+li{margin-top:8px}footer{min-height:50px;padding:15px clamp(18px,5vw,72px);background:#0b2d28;color:#bfd0ca;font-size:.82rem}@media(max-width:880px){main{grid-template-columns:1fr}.intro{padding-block:52px}.surface{padding:42px 20px}}@media(max-width:560px){header{padding-inline:16px}.brand strong{font-size:.9rem}header>a:last-child{font-size:.82rem}.flow-form{grid-template-columns:1fr}.field{grid-column:1/-1}.actions{display:grid}.actions .button{width:100%}}
  .intro h1{font-size:3.4rem}
  @media(max-width:880px){.intro h1{font-size:3.2rem}}
  @media(max-width:560px){.intro h1{font-size:2.7rem}}
</style>
