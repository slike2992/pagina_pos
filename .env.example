PUBLIC_SAAS_API_URL=http://localhost:4100
# URL pública del POS. En una red local debe usar la IP LAN del servidor.
PUBLIC_POS_URL=http://localhost:3002
# Número comercial con indicativo de país, sin espacios ni símbolos.
PUBLIC_WHATSAPP_NUMBER=

# Solo el build público autorizado debe habilitar indexación. Dev siempre noindex.
PUBLIC_SITE_INDEXABLE=false
# Opcional: token PUBLICO de verificación Search Console. DNS es preferible para dominio.
PUBLIC_GOOGLE_SITE_VERIFICATION=
# Opcional: ID público GA4. Vacío = sin etiqueta, cookies ni aviso de analítica.
PUBLIC_GA_MEASUREMENT_ID=
# Solo artefactos de revisión; incompatible con un release indexable.
PUBLIC_LEGAL_DRAFT_PREVIEW=false
# Solo tras revisar la propiedad real, sus capturas automáticas y privacidad.
PUBLIC_ANALYTICS_REVIEWED=false
